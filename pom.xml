<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>org.folio.factory</groupId>
  <artifactId>factory-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FOLIO AI SDLC Factory</name>
  <description>Plugin-based AI orchestration platform for the FOLIO software development lifecycle</description>

  <modules>
    <module>factory-core</module>
    <module>factory-connectors</module>
    <module>factory-agents</module>
    <module>factory-flow-test-factory</module>
    <module>factory-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-ai.version>2.0.0</spring-ai.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <wiremock.version>3.13.1</wiremock.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.folio.factory</groupId>
        <artifactId>factory-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.folio.factory</groupId>
        <artifactId>factory-connectors</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.folio.factory</groupId>
        <artifactId>factory-agents</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.folio.factory</groupId>
        <artifactId>factory-flow-test-factory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <!-- Opt-in software-composition-analysis (DEP-1). Excluded from default builds
         (slow, network-bound). Run with:  mvn -Powasp verify
         Add  -Dnvd.api.key=<key>  to avoid NVD rate limiting. Runs once at the
         reactor root via the aggregate goal + <inherited>false</inherited>. -->
    <profile>
      <id>owasp</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>12.2.2</version>
            <inherited>false</inherited>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
                <format>SARIF</format>
              </formats>
              <skipProvidedScope>true</skipProvidedScope>
              <dataDirectory>${session.executionRootDirectory}/.dependency-check-data</dataDirectory>
              <suppressionFiles>
                <suppressionFile>${session.executionRootDirectory}/owasp-suppressions.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals>
                  <goal>aggregate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
