# M1 Sprint Pilot: one prepared startup path from a fresh clone.
# Copy this file: cp .env.pilot.example .env
# Fill in every empty required value below, then run the single start command:
#   scripts/start-pilot.sh
# The start action validates prerequisites, discloses a small bounded smoke
# (one tiny tool-using model call, at most 5 turns and 2 minutes, no task
# repository, no Jira writes, no publication) and reports readiness. Fix the
# reported blocker and repeat the SAME command after any correction — no manual
# disable/check/flag/restart choreography is needed. Restarts never repeat the
# paid smoke while the runtime configuration is unchanged.
# Never commit or share .env: it holds credentials.

# ---- Connections (required) ----

# Jira instance used for read-only discovery: base URL, account email, API token.
FACTORY_CONNECTORS_JIRA_BASE_URL=
FACTORY_CONNECTORS_JIRA_EMAIL=
FACTORY_CONNECTORS_JIRA_API_TOKEN=

# GitHub token with push permission for the delivery repositories you authorize.
# Same-repository branch creation needs push access to that repository (the
# destination you set below), not to folio-org. Source repositories must be
# public; source checkout does not use this token.
FACTORY_CONNECTORS_GITHUB_TOKEN=

# ---- Coding runtime (defaults match the supported local CodeMie profile) ----

# Start your CodeMie proxy on port 4001 yourself; Compose does not manage it.
FACTORY_DEV_FACTORY_CODING_RUNTIME=claude-code
FACTORY_CLAUDE_CODE_API=anthropic-messages
FACTORY_CLAUDE_CODE_BASE_URL=http://host.docker.internal:4001
FACTORY_CLAUDE_CODE_MODEL=claude-sonnet-5-5
FACTORY_CLAUDE_CODE_AUTHENTICATION=bearer-token
FACTORY_CLAUDE_CODE_AUTH_TOKEN=codemie-proxy

# ---- Team source (required) ----

# One team board or saved filter URL/ID; one sprint; eligible statuses.
# Values containing spaces must stay quoted, e.g. FACTORY_PILOT_STATUSES="To Do".
FACTORY_PILOT_SOURCE=
FACTORY_PILOT_SPRINT_ID=
FACTORY_PILOT_STATUSES="To Do"

# To obtain the sprint ID: open the board, choose the sprint in the backlog and
# read the numeric id from the backlog URL (…?agileSprintID=4711), or run:
#   curl -s -u "$FACTORY_CONNECTORS_JIRA_EMAIL:$FACTORY_CONNECTORS_JIRA_API_TOKEN" \
#     "$FACTORY_CONNECTORS_JIRA_BASE_URL/rest/agile/1.0/board/981/sprint?state=active"
# (replace 981 with your board ID). The sprint is displayed by name in Factory.

# Optional AND narrowings on top of the team source. Empty adds no restriction.
# FACTORY_PILOT_ASSIGNEE=
# FACTORY_PILOT_PROJECTS=
# FACTORY_PILOT_LABEL=

# Non-overlapping installation filters: each Factory installation must use its
# own team source (board or saved filter). Two installations polling the same
# source would both discover and delegate the same tasks.

# ---- Pilot switches ----

# Read-only discovery of the team source every five minutes.
FACTORY_PILOT_DISCOVERY_ENABLED=true
# Pilot processing (outcomes, recovery, serial dispatch).
FACTORY_PILOT_EXECUTION_ENABLED=true

# Destructive retention must stay disabled for the pilot: it purges terminal
# execution history, and pilot attempts/evidence are never deleted. The start
# action refuses pilot execution while retention is enabled; it never changes
# the setting for you.
FACTORY_RETENTION_ENABLED=false

# ---- Prepared repository destinations ----

# The catalog (config/developer-repositories.yaml or your own copy via
# FACTORY_DEV_FACTORY_REPOSITORIES_FILE) owns source, base branch, build and
# verification policy. Below, enable exactly the destinations you authorize,
# with one official (folio-org) example and one personal fork for testing.
# Delivery is blocked unless a target is explicitly authorized; authorization
# means automatic push and PR creation to that repository.

# Official destination example — only when the team accepts automated PRs there:
# FACTORY_MGR_APPLICATIONS_DELIVERY_REPO=folio-org/mgr-applications
# FACTORY_MGR_APPLICATIONS_BASE_BRANCH=master
# FACTORY_MGR_APPLICATIONS_DELIVERY_AUTHORIZED=true

# Testing destination example — a fork you own (replace your-github-user):
FACTORY_SIDECAR_SOURCE_REPO=your-github-user/folio-module-sidecar
FACTORY_SIDECAR_DELIVERY_REPO=your-github-user/folio-module-sidecar
FACTORY_SIDECAR_BASE_BRANCH=master
FACTORY_SIDECAR_DELIVERY_AUTHORIZED=true
