# Developer Flow: your Jira tasks become pull requests under your name.
# Copy this file: cp .env.pilot.example .env
# Fill in your Jira name and your GitHub token, then start the stack:
#   docker compose up -d
# and open http://localhost:8080/flows/dev-factory.
# After editing .env, run docker compose up -d again to apply the change.
# Never commit or share .env: it holds your GitHub token.

# Jira that Factory reads anonymously: no Jira account or token is needed.
FACTORY_CONNECTORS_JIRA_BASE_URL=https://folio-org.atlassian.net

# Your name exactly as Jira shows it, or your Jira accountId.
# Keep a name with spaces in quotes, e.g. FACTORY_PILOT_ASSIGNEE="Jane Developer".
FACTORY_PILOT_ASSIGNEE=

# Your GitHub token. Pull requests are opened under your name, so the token needs
# push access to each delivery repository: folio-org by default, or your fork below.
FACTORY_CONNECTORS_GITHUB_TOKEN=

# Runs the queue: starts the tasks you run, records outcomes, moves to the next task.
FACTORY_PILOT_EXECUTION_ENABLED=true

# Optional: run tasks with GLM-5.3 from Z.ai. Put your Z.ai key here, then choose a GLM profile
# in the run form. The profiles are in config/developer-run-profiles.yaml.
# FACTORY_ZAI_API_KEY=
# Optional: the profile the run form preselects. Empty: env-default, the CodeMie proxy.
# FACTORY_DEV_FACTORY_DEFAULT_RUN_PROFILE=glm-5.3
# Optional: default effort of env-default: low, medium, high, xhigh or max (empty: high).
# FACTORY_CLAUDE_CODE_EFFORT=

# Optional: deliver one repository to your fork instead of folio-org. Set both
# lines for that repository; the names are in config/developer-repositories.yaml.
# FACTORY_SIDECAR_SOURCE_REPO=your-github-user/folio-module-sidecar
# FACTORY_SIDECAR_DELIVERY_REPO=your-github-user/folio-module-sidecar
