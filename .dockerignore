# Host build output — the image rebuilds these; stale/wrong-arch classes must not leak in.
**/target/

# VCS and IDE
.git/
.gitignore
.idea/
*.iml
.project
.classpath
.settings/
.vscode/

# OS / editor cruft
.DS_Store
*.log

# Docs, license and CI are not needed inside the build context.
# NOTE: do NOT add a broad `*.md` / `**/*.md` rule — the Test Factory flow ships prompt resources at
# */src/main/resources/prompts/**/*.md that must remain in the context and on the classpath.
doc/
scripts/
.github/
README.md
CLAUDE.md
LICENSE

# Local-only infra and this build's own files
docker-compose.yml
Dockerfile
.dockerignore
owasp-suppressions.xml
.dependency-check-data/
