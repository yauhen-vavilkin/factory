<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file (referenced by the `owasp` Maven profile in
  the root pom.xml). Add a <suppress> entry for each VERIFIED false positive. Every
  entry MUST carry a justification in <notes> and, ideally, an `until` date so
  suppressions are periodically re-reviewed rather than accumulating silently.

  Example:
  <suppress until="2026-12-31Z">
    <notes>False positive: CVE targets the standalone CLI, not the embedded library.</notes>
    <packageUrl regex="true">^pkg:maven/org\.example/.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
