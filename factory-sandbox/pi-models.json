{
  "providers": {
    "openai-compatible": {
      "baseUrl": "http://factory-gateway:8080/v1",
      "api": "openai-completions",
      "apiKey": "$FACTORY_MODEL_TOKEN",
      "models": [
        {
          "id": "factory-coding",
          "name": "Factory coding model",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 65536,
          "maxTokens": 16384,
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": true,
            "maxTokensField": "max_tokens",
            "thinkingFormat": "zai",
            "zaiToolStream": true,
            "supportsStrictMode": false,
            "requiresReasoningContentOnAssistantMessages": true
          },
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        }
      ]
    }
  }
}
