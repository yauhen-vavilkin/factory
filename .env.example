# FOLIO AI SDLC Factory — sample environment.
#
# Copy to .env (git-ignored) and fill in what you need:
#
#   cp .env.example .env
#
# Nothing loads .env automatically — there is no dotenv dependency, and
# docker-compose.yml only configures PostgreSQL. Export it into your shell
# before starting the app:
#
#   set -a; source .env; set +a
#   mvn spring-boot:run -pl factory-app
#
# Every value below is optional and shown at its built-in default, except the
# LLM key. With zero connector credentials the Test Factory flow still runs
# end to end in advisory mode — external syncs are audited as CONNECTOR_SKIPPED.
# Full reference: the configuration table in README.md.

# ---------------------------------------------------------------- LLM provider
# The only setting you normally must supply. Without a key the app boots, warns
# at startup, and LLM-backed steps fail at runtime and escalate to human review.

ANTHROPIC_API_KEY=

# FACTORY_LLM_PROVIDER=anthropic
# FACTORY_LLM_MODEL=claude-sonnet-4-5

# Set FACTORY_LLM_PROVIDER=openai to use any OpenAI-compatible endpoint
# (Groq, Gemini, OpenRouter, local Ollama). ANTHROPIC_API_KEY is then unused.
# FACTORY_LLM_PROVIDER=openai
# FACTORY_LLM_API_KEY=
# FACTORY_LLM_BASE_URL=https://api.groq.com/openai/v1
# FACTORY_LLM_COMPLETIONS_PATH=/chat/completions
# FACTORY_LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------- Database
# Defaults match docker-compose.yml, so `docker compose up -d` needs no change.

# FACTORY_DB_URL=jdbc:postgresql://localhost:5432/factory
# FACTORY_DB_USER=factory
# FACTORY_DB_PASSWORD=factory

# Pool sizing — raise FACTORY_DB_POOL_MAX in lockstep with engine worker-threads.
# See doc/performance.md.
# FACTORY_DB_POOL_MAX=16
# FACTORY_DB_POOL_MIN_IDLE=4
# FACTORY_DB_POOL_CONNECTION_TIMEOUT_MS=30000
# FACTORY_DB_POOL_MAX_LIFETIME_MS=1800000
# FACTORY_DB_POOL_IDLE_TIMEOUT_MS=600000
# FACTORY_DB_POOL_LEAK_DETECTION_MS=60000

# ------------------------------------------------------------------- Webhooks
# /api/webhooks/jira and /api/webhooks/github are UNAUTHENTICATED while this is
# unset (the app warns at startup). Checked against the ?token= query param.
# Always set it outside local development.

# FACTORY_WEBHOOKS_SHARED_SECRET=

# ----------------------------------------------------------------- Connectors
# Each connector activates only when ALL of its variables are set; otherwise the
# step is audited as CONNECTOR_SKIPPED and the flow continues.

# FACTORY_CONNECTORS_JIRA_BASE_URL=
# FACTORY_CONNECTORS_JIRA_EMAIL=
# FACTORY_CONNECTORS_JIRA_API_TOKEN=

# FACTORY_CONNECTORS_GITHUB_TOKEN=
# FACTORY_CONNECTORS_GITHUB_BASE_URL=          # only for GitHub Enterprise

# ----------------------------------------------------- Developer Flow demo
# Pi/model credentials stay in the trusted Factory container and are copied only
# into the isolated coding workload's private Pi configuration.
# FACTORY_MODEL_PROVIDER=openai-compatible
# FACTORY_MODEL_ID=
# FACTORY_MODEL_BASE_URL=
# FACTORY_MODEL_API=openai-completions
# FACTORY_MODEL_API_KEY=
# FACTORY_DEV_FACTORY_CODING_IMAGE=factory-dev-pi:0.85.1-java21
# FACTORY_DEV_FACTORY_TIMEOUT_SECONDS=1800

# Delivery is disabled until all three values are set explicitly. The destination
# must be a user-owned fork; folio-org is rejected by the delivery code.
# FACTORY_DEV_FACTORY_DELIVERY_REPOSITORY=your-user/folio-module-sidecar
# FACTORY_DEV_FACTORY_DELIVERY_BASE_BRANCH=master
# FACTORY_DEV_FACTORY_DELIVERY_AUTHORIZED=true
# FACTORY_DEV_FACTORY_CREATE_PR=true

# FACTORY_CONNECTORS_TESTRAIL_BASE_URL=
# FACTORY_CONNECTORS_TESTRAIL_USERNAME=
# FACTORY_CONNECTORS_TESTRAIL_API_KEY=
# FACTORY_CONNECTORS_TESTRAIL_PROJECT_ID=

# Outbound HTTP timeouts for the connectors (Durations, e.g. 10s / 500ms).
# FACTORY_HTTP_CONNECT_TIMEOUT=5s
# FACTORY_HTTP_READ_TIMEOUT=30s

# ---------------------------------------------------- Test Factory flow (A)
# FACTORY_TEST_FACTORY_TARGET_REPO=            # owner/repo receiving test scripts
# FACTORY_TEST_FACTORY_BASE_BRANCH=main
# FACTORY_TEST_FACTORY_TESTRAIL_SECTION_ID=
# FACTORY_TEST_FACTORY_JIRA_TRANSITION=

# Both are required to run Karate for real; otherwise execution is advisory.
# FACTORY_TEST_FACTORY_EXECUTION_BASE_URL=
# FACTORY_TEST_FACTORY_EXECUTION_KARATE_JAR=

# --------------------------------------------------------------- Engine tuning
# FACTORY_ENGINE_POLL_INTERVAL_MS=2000
# FACTORY_ENGINE_BATCH_SIZE=5
# FACTORY_ENGINE_WORKER_THREADS=4
# FACTORY_ENGINE_REAP_INTERVAL_MS=30000
# Must exceed the longest legitimate step. For Developer Flow, keep it above twice
# FACTORY_DEV_FACTORY_TIMEOUT_SECONDS plus setup/freezing margin.
# FACTORY_ENGINE_LEASE_TIMEOUT_SECONDS=7200
# FACTORY_ENGINE_SHUTDOWN_AWAIT_SECONDS=30
# SINGLE-INSTANCE ONLY — set false for multi-instance (see doc/runbook.md).
# FACTORY_ENGINE_RECLAIM_RUNNING_ON_STARTUP=true
# FACTORY_SHUTDOWN_PHASE_TIMEOUT=60s

# ------------------------------------------------------------- Cost and limits
# 0 disables a guard. The daily budget answers 429 once exhausted.
# FACTORY_LIMITS_MAX_CONCURRENT_EXECUTIONS=8
# FACTORY_LIMITS_MAX_EXECUTIONS_PER_DAY=200
# FACTORY_LIMITS_MAX_ARTIFACT_BYTES=5000000
# FACTORY_LIMITS_MAX_TRIGGER_PAYLOAD_BYTES=262144
# Re-fires of the same payload within the window collapse onto the first run.
# FACTORY_LIMITS_DEDUP_ENABLED=true
# FACTORY_LIMITS_DEDUP_WINDOW=10m
# FACTORY_LIMITS_DEDUP_ID_POINTERS=/issueKey

# ------------------------------------------------------ Retention and logging
# Destructive, so opt-in: purges terminal execution trees past the TTL.
# The audit log is never purged. Set the cron to "-" to disable the trigger.
# FACTORY_RETENTION_ENABLED=false
# FACTORY_RETENTION_TTL_DAYS=90
# FACTORY_RETENTION_BATCH_SIZE=100
# FACTORY_RETENTION_RUN_CRON=0 30 3 * * *

# Structured JSON logging: ecs, logstash or gelf. Empty keeps it human-readable.
# FACTORY_LOG_FORMAT=
