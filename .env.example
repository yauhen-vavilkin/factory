# Local Factory configuration. Copy to .env and set the provider values locally.
# .env is ignored and must remain mode 0600.
FACTORY_CODING_RUNTIME=pi
# What the coding sandbox sees: a generic protocol and a stable model alias.
FACTORY_MODEL_PROVIDER=openai-compatible
FACTORY_MODEL_ALIAS=factory-coding
# Trusted host/gateway configuration only; never passed to the sandbox.
# Any OpenAI-compatible chat-completions endpoint (HTTPS, no credentials in the URL).
FACTORY_MODEL_BASE_URL=https://llm.example.invalid/v1
FACTORY_MODEL_ID=upstream-model-id
FACTORY_MODEL_API_KEY=
FACTORY_MODEL_THINKING=high
FACTORY_MODEL_CONTEXT_TOKENS=65536
FACTORY_MODEL_MAX_OUTPUT_TOKENS=16384
FACTORY_ALLOW_UNPRICED=true

FACTORY_POSTGRES_PORT=55432
FACTORY_APP_PORT=18080
FACTORY_GATEWAY_PORT=18081
