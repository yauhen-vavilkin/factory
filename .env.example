# Local Developer Flow: Claude Code + Sonnet 5.5 through CodeMie.
# Copy this file: cp .env.example .env
# Start your CodeMie proxy on port 4001, then fill in the empty values below.
# Start Factory: docker compose up -d --build
# Repositories, branches and where pull requests go: config/developer-repositories.yaml.
# Pull requests go to the official folio-org repositories unless you point a repository
# at your fork (README.md).
# Other runtimes, Test Factory and tuning settings are documented in README.md.

# Coding harness that implements Developer Flow tasks.
FACTORY_DEV_FACTORY_CODING_RUNTIME=claude-code

# Protocol exposed by the CodeMie proxy for Claude Code.
FACTORY_CLAUDE_CODE_API=anthropic-messages

# Host proxy address as seen from Docker; the CLI appends /v1/messages.
FACTORY_CLAUDE_CODE_BASE_URL=http://host.docker.internal:4001

# Literal model deployment ID sent to the proxy.
FACTORY_CLAUDE_CODE_MODEL=claude-sonnet-5-5

# CodeMie expects Authorization: Bearer; x-api-key is not used.
FACTORY_CLAUDE_CODE_AUTHENTICATION=bearer-token

# Standard local gateway token; CodeMie manages upstream authentication.
FACTORY_CLAUDE_CODE_AUTH_TOKEN=codemie-proxy

# Maximum CLI turns in one coding attempt.
FACTORY_CLAUDE_CODE_MAX_TURNS=40

# Timeout in seconds for a runtime command; 1800 seconds is 30 minutes.
FACTORY_DEV_FACTORY_TIMEOUT_SECONDS=1800

# Jira instance used to read task details.
FACTORY_CONNECTORS_JIRA_BASE_URL=

# Email used to authenticate Jira requests.
FACTORY_CONNECTORS_JIRA_EMAIL=

# Jira API token for the account above.
FACTORY_CONNECTORS_JIRA_API_TOKEN=

# GitHub token that can push to the delivery repositories (folio-org by default).
FACTORY_CONNECTORS_GITHUB_TOKEN=
