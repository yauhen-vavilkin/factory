# Local Developer Flow: Claude Code + Sonnet 5.5 through CodeMie.
# To start, copy .env.tasks.example to .env (README.md, My tasks quick start).
# This file lists more settings: copy a line from it into .env when you need it.
# Repositories, branches and where pull requests go: config/developer-repositories.yaml.
# Pull requests go to the official folio-org repositories unless you point a repository
# at your fork (README.md).
# Other runtimes, Test Factory and tuning settings are documented in README.md.

# Coding harness that implements Developer Flow tasks.
FACTORY_DEV_FACTORY_CODING_RUNTIME=claude-code

# The models you can run, with their endpoints and prices, are in config/developer-models.yaml.
# This file holds only their secrets. Standard local gateway token of the CodeMie proxy;
# CodeMie manages upstream authentication.
FACTORY_CODEMIE_PROXY_TOKEN=codemie-proxy

# Optional: Sonnet straight from the Anthropic API, with your own key.
# FACTORY_ANTHROPIC_API_KEY=
# Optional: Z.ai key for the GLM models; a model whose key is empty is not offered.
# FACTORY_ZAI_API_KEY=
# Model preselected in the run forms and used by runs that name none. Empty: the first model
# in config/developer-models.yaml that the harness can run.
# FACTORY_DEV_FACTORY_DEFAULT_MODEL=glm-5.3
# Your own copy of the models file, mounted read-only.
# FACTORY_DEV_FACTORY_MODELS_FILE=./config/my-models.yaml

# Images attached to the Jira ticket (png, jpeg, gif, webp) reach a model only when its entry in
# config/developer-models.yaml says images: true; for Pi set FACTORY_PI_IMAGES=true.
# Limits: how many images (0 = no limit) and the largest file in bytes.
# FACTORY_DEV_FACTORY_ATTACHMENT_MAX_IMAGES=10
# FACTORY_DEV_FACTORY_ATTACHMENT_MAX_BYTES=3145728

# UI modules (yarn + Jest): the trusted yarn cache volume and the registry for @folio/* packages.
# FACTORY_DEV_FACTORY_YARN_CACHE_VOLUME=factory-dev-yarn-cache
# FACTORY_DEV_FACTORY_FOLIO_NPM_REGISTRY=https://repository.folio.org/repository/npm-folioci/
# Seconds allowed to copy the shared dependency cache into one workload; a 3.4 GB yarn cache
# took about 57 s.
# FACTORY_DEV_FACTORY_SEED_TIMEOUT_SECONDS=300

# Safety limit of CLI turns in one coding attempt, from 1 to 500. The timeout below usually
# ends a run first; a run that hits either limit loses its work.
FACTORY_CLAUDE_CODE_MAX_TURNS=400

# Timeout in seconds for a runtime command; 3600 seconds is 60 minutes.
FACTORY_DEV_FACTORY_TIMEOUT_SECONDS=3600

# Jira instance used to read task details.
FACTORY_CONNECTORS_JIRA_BASE_URL=

# Email used to authenticate Jira requests.
FACTORY_CONNECTORS_JIRA_EMAIL=

# Jira API token for the account above.
FACTORY_CONNECTORS_JIRA_API_TOKEN=

# GitHub token that can push to the delivery repositories (folio-org by default).
FACTORY_CONNECTORS_GITHUB_TOKEN=
