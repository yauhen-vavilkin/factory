FROM maven:3.9-eclipse-temurin-21
# Official stable channel resolved on 2026-10-14. Checksums from the release manifest:
# https://downloads.claude.ai/claude-code-releases/2.1.287/manifest.json
RUN set -eu; \
    case "$(uname -m)" in \
      aarch64) platform=linux-arm64; checksum=e4daf793d1e74fb0d9874dd09e98690bbfd7be515f78a87fd05b9e2b4bb33b03 ;; \
      x86_64) platform=linux-x64; checksum=3920489a5109cff5786a1a392c25277408ff22bc796d5edb9c16a60e5a1718f0 ;; \
      *) exit 1 ;; \
    esac; \
    curl -fsSL "https://downloads.claude.ai/claude-code-releases/2.1.287/$platform/claude" -o /usr/local/bin/claude; \
    echo "$checksum  /usr/local/bin/claude" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/claude
ENV DISABLE_AUTOUPDATER=1 DISABLE_UPDATES=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
RUN test "$(claude --version)" = '2.1.287 (Claude Code)'
WORKDIR /workspace
