#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE_DIR="$ROOT_DIR/.factory"
CONFIG_FILE="$STATE_DIR/config/factory.env"
PASSWORD_FILE="$STATE_DIR/secrets/postgres-password"
PID_FILE="$STATE_DIR/run/factory.pid"
APP_LOG="$STATE_DIR/logs/factory.log"

fail() {
  echo "factory: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  ./scripts/factory init
  ./scripts/factory infra up|down
  ./scripts/factory doctor --offline
  ./scripts/factory start --mode offline|live|pi
  ./scripts/factory smoke --pi --scripted
  ./scripts/factory evidence-verify
  ./scripts/factory stop
  ./scripts/factory validate --unit|--integration|--eval-pack
  ./scripts/factory resolve-task TASK.yaml
  ./scripts/factory submit TASK.yaml
EOF
}

require_init() {
  [[ -f "$CONFIG_FILE" && -f "$PASSWORD_FILE" ]] ||
    fail "not initialized; run ./scripts/factory init"
}

load_config() {
  require_init
  set -a
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  set +a
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

init_factory() {
  umask 077
  mkdir -p "$STATE_DIR/config" "$STATE_DIR/secrets" "$STATE_DIR/data/postgres" \
    "$STATE_DIR/data/artifacts" "$STATE_DIR/data/recovery" "$STATE_DIR/data/inbox" \
    "$STATE_DIR/data/sandboxes" "$STATE_DIR/cache/maven-home" \
    "$STATE_DIR/cache/maven-repository" "$STATE_DIR/logs/validation" \
    "$STATE_DIR/run"
  find "$STATE_DIR" -type d -exec chmod 700 {} + 2>/dev/null || true
  if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '%s\n' 'FACTORY_POSTGRES_PORT=55432' 'FACTORY_APP_PORT=18080' > "$CONFIG_FILE"
  fi
  if [[ ! -f "$PASSWORD_FILE" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      openssl rand -hex 24 > "$PASSWORD_FILE"
    else
      fail "openssl is required to create the local PostgreSQL password"
    fi
  fi
  chmod 600 "$CONFIG_FILE" "$PASSWORD_FILE"
  echo "Factory state initialized at $STATE_DIR"
}

compose() {
  load_config
  (cd "$ROOT_DIR" && docker compose "$@")
}

infra() {
  case "${1:-}" in
    up)
      compose up -d --wait postgres
      ;;
    down)
      compose down
      ;;
    *) fail "infra requires up or down" ;;
  esac
}

doctor_offline() {
  load_config
  command -v java >/dev/null || fail "Java 21 is required"
  [[ $(java -version 2>&1 | head -1) == *'21.'* ]] || fail "Java 21 is required"
  [[ -x "$ROOT_DIR/mvnw" ]] || fail "the pinned Maven Wrapper is missing or not executable"
  command -v docker >/dev/null || fail "Docker is required for PostgreSQL"
  docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable (BLOCKED_REQUIRES_DOCKER)"
  compose ps --status running postgres | grep -q postgres ||
    fail "PostgreSQL is not running; run ./scripts/factory infra up"
  [[ $(file_mode "$STATE_DIR") == 700 ]] || fail "$STATE_DIR must have mode 0700"
  [[ $(file_mode "$CONFIG_FILE") == 600 ]] || fail "$CONFIG_FILE must have mode 0600"
  [[ $(file_mode "$PASSWORD_FILE") == 600 ]] || fail "$PASSWORD_FILE must have mode 0600"
  echo "Offline doctor: OK (Java 21, wrapper, Docker, PostgreSQL, permissions)"
  echo "Offline model: scripted local ChatModel; API credentials are not read"
}

running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid=$(<"$PID_FILE")
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if ps -p "$pid" -o command= 2>/dev/null | grep -q 'factory-app.*\.jar'; then
    return 0
  fi
  command -v lsof >/dev/null &&
    lsof -nP -p "$pid" 2>/dev/null | grep '/factory-app/target/factory-app-.*\.jar' >/dev/null
}

start_factory() {
  [[ "${1:-}" == "--mode" ]] || fail "start requires --mode offline or --mode live"
  local mode="${2:-}"
  [[ "$mode" == offline || "$mode" == live || "$mode" == pi ]] || fail "mode must be offline, live, or pi"
  load_config
  if running_pid; then
    fail "Factory is already running with PID $(<"$PID_FILE")"
  fi
  if curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/actuator/health" >/dev/null 2>&1; then
    fail "another Factory instance is already listening on 127.0.0.1:${FACTORY_APP_PORT}"
  fi
  rm -f "$PID_FILE"
  mkdir "$STATE_DIR/run/start.lock" 2>/dev/null || fail "another Factory start is in progress"
  trap 'rmdir "$STATE_DIR/run/start.lock" 2>/dev/null || true' EXIT

  if [[ "$mode" == offline ]]; then
    doctor_offline
  elif [[ "$mode" == live && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    fail "live mode requires ANTHROPIC_API_KEY; no provider request was made"
  fi

  (cd "$ROOT_DIR" && export MAVEN_USER_HOME="$STATE_DIR/cache/maven-home" && \
    ./mvnw -B -pl factory-app -am package -DskipTests)
  local jar="$ROOT_DIR/factory-app/target/factory-app-0.1.0-SNAPSHOT.jar"
  [[ -f "$jar" ]] || fail "application jar was not built: $jar"
  local db_password
  db_password=$(<"$PASSWORD_FILE")
  : > "$APP_LOG"
  (
    export SPRING_PROFILES_ACTIVE="$mode"
    export FACTORY_MODE="$mode"
    export FACTORY_APP_PORT FACTORY_POSTGRES_PORT
    export FACTORY_DATA_DIR="$STATE_DIR/data"
    export FACTORY_DB_URL="jdbc:postgresql://127.0.0.1:${FACTORY_POSTGRES_PORT}/factory"
    export FACTORY_DB_USER=factory
    export FACTORY_DB_PASSWORD="$db_password"
    export FACTORY_EXTERNAL_WRITES_ENABLED=false
    if [[ "$mode" == pi ]]; then export FACTORY_INBOX_EVENT_TYPE=file.inbox.pi; fi
    if [[ "$mode" == offline ]]; then
        unset ANTHROPIC_API_KEY GLM_API_KEY FACTORY_LLM_BASE_URL FACTORY_LLM_MODEL
    fi
    exec nohup java -jar "$jar"
  ) >> "$APP_LOG" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  chmod 600 "$PID_FILE" "$APP_LOG"
  rmdir "$STATE_DIR/run/start.lock"
  trap - EXIT

  local attempt
  for attempt in $(seq 1 90); do
    if curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/actuator/health" >/dev/null 2>&1; then
      echo "Factory is ready in $mode mode at http://127.0.0.1:${FACTORY_APP_PORT} (PID $pid)"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      tail -40 "$APP_LOG" >&2
      fail "Factory exited before readiness"
    fi
    sleep 1
  done
  stop_factory || true
  tail -40 "$APP_LOG" >&2
  fail "Factory did not become ready within 90 seconds"
}

smoke_pi_scripted() {
  [[ $# == 2 && "$1" == --pi && "$2" == --scripted ]] || fail "smoke requires --pi --scripted"
  init_factory >/dev/null
  command -v docker >/dev/null || fail "Docker is required for Pi smoke"
  docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable (BLOCKED_REQUIRES_DOCKER)"
  local log="$STATE_DIR/logs/validation/pi-smoke.log"
  mkdir -p "$(dirname "$log")"
  docker build -q -t factory-pi:jdk21 "$ROOT_DIR/factory-sandbox" >> "$log"
  local network="factory-pi-smoke-$$"
  docker network create --internal --driver bridge "$network" >> "$log"
  trap 'docker network rm "$network" >/dev/null 2>&1 || true' RETURN
  local gateway
  gateway=$(docker run -d --rm --network "$network" --network-alias factory-gateway --name "${network}-gateway" \
    -v "$STATE_DIR/logs/validation:/evidence" python:3.12-alpine python -c 'import json
from http.server import BaseHTTPRequestHandler,HTTPServer
log=open("/evidence/upstream-requests.jsonl","w")
class H(BaseHTTPRequestHandler):
  def log_message(self,*a): pass
  def do_GET(self):
    if self.path == "/health": self.send_response(200); self.end_headers(); self.wfile.write(b"ok")
    else: self.send_error(404)
  def do_POST(self):
    if self.path != "/v1/chat/completions": self.send_error(404); return
    n=int(self.headers.get("Content-Length",0)); body=json.loads(self.rfile.read(n)); messages=body.get("messages",[])
    log.write(json.dumps({"model":body.get("model"),"messageCount":len(messages),"hasTools":bool(body.get("tools"))})+"\n"); log.flush()
    tool_count=sum(1 for m in messages if m.get("role")=="tool")
    if tool_count == 0:
      msg={"role":"assistant","content":None,"tool_calls":[{"id":"read-1","type":"function","function":{"name":"read","arguments":json.dumps({"path":"README.md"})}}]}
    elif tool_count == 1:
      msg={"role":"assistant","content":None,"tool_calls":[{"id":"bash-1","type":"function","function":{"name":"bash","arguments":json.dumps({"command":"git config --global --add safe.directory /workspace/repo && sed -i \"s/return value;/return value.trim().toLowerCase();/\" src/main/java/factory/Normalizer.java && git add . && git commit -m pi-normalization-candidate"})}}]}
    else: msg={"role":"assistant","content":"Pi completed the requested fixture change."}
    delta={"role":"assistant"} if msg.get("tool_calls") else {"content":msg.get("content","")}
    if msg.get("tool_calls"): delta["tool_calls"]=[{"index":0,"id":msg["tool_calls"][0]["id"],"type":"function","function":{"name":msg["tool_calls"][0]["function"]["name"],"arguments":msg["tool_calls"][0]["function"]["arguments"]}}]
    chunks=[{"id":"scripted","choices":[{"index":0,"delta":delta,"finish_reason":None}]},{"id":"scripted","choices":[{"index":0,"delta":{},"finish_reason":"tool_calls" if msg.get("tool_calls") else "stop"}]}]
    self.send_response(200); self.send_header("Content-Type","text/event-stream"); self.send_header("Cache-Control","no-cache"); self.end_headers()
    for chunk in chunks: self.wfile.write(("data: "+json.dumps(chunk)+"\n\n").encode()); self.wfile.flush()
    self.wfile.write(b"data: [DONE]\n\n"); self.wfile.flush()
HTTPServer(("0.0.0.0",8080),H).serve_forever()')
  for _ in $(seq 1 20); do
    docker run --rm --network "$network" python:3.12-alpine python -c 'import urllib.request; urllib.request.urlopen("http://factory-gateway:8080/health")' >/dev/null 2>&1 && break
    sleep 0.2
  done
  local direct_egress=ALLOWED
  if ! docker run --rm --network "$network" --network-alias direct-probe python:3.12-alpine \
      python -c 'import urllib.request; urllib.request.urlopen("https://example.com", timeout=2)' \
      >/dev/null 2>&1; then direct_egress=DENIED; fi
  [[ "$direct_egress" == DENIED ]] || fail "sandbox network permits direct egress"
  local fixture
  local fixed_git_date="2020-01-01T00:00:00Z"
  fixture=$(mktemp -d "$STATE_DIR/data/sandboxes/pi-smoke-fixture.XXXXXX")
  local verify="$STATE_DIR/data/sandboxes/pi-smoke-verify.$$"
  mkdir -p "$verify"
  git -C "$fixture" init -q -b main
  git -C "$fixture" config user.name Factory-Smoke; git -C "$fixture" config user.email smoke@factory.invalid
  mkdir -p "$fixture/src/main/java/factory" "$fixture/src/test/java/factory"
  printf '%s\n' '# Pi normalization fixture' 'The candidate must normalize input.' > "$fixture/README.md"
  cat > "$fixture/pom.xml" <<'EOF'
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion><groupId>factory</groupId><artifactId>pi-fixture</artifactId><version>1</version><properties><maven.compiler.release>21</maven.compiler.release><maven.compiler.source>21</maven.compiler.source><maven.compiler.target>21</maven.compiler.target><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties><dependencies><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.0</version><scope>test</scope></dependency></dependencies><build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin></plugins></build></project>
EOF
  printf '%s\n' 'package factory;' 'public final class Normalizer {' '  private Normalizer() {}' '  public static String normalize(String value) { return value; }' '}' > "$fixture/src/main/java/factory/Normalizer.java"
  printf '%s\n' 'package factory;' 'import static org.junit.jupiter.api.Assertions.assertEquals;' 'import org.junit.jupiter.api.Test;' 'class NormalizerTest {' '  @Test void normalizesWhitespaceAndCase() {' '    assertEquals("folio", Normalizer.normalize("  FOLIO  "));' '  }' '}' > "$fixture/src/test/java/factory/NormalizerTest.java"
  git -C "$fixture" add .; GIT_AUTHOR_DATE="$fixed_git_date" GIT_COMMITTER_DATE="$fixed_git_date" \
    git -C "$fixture" commit -q -m base
  chmod -R a+rwX "$fixture"
  local base candidate_head candidate
  base=$(git -C "$fixture" rev-parse HEAD)
  local raw="$STATE_DIR/logs/validation/pi-rpc.jsonl"
  : > "$raw"
  { printf '%s\n' '{"type":"get_state","id":"smoke-state"}' '{"type":"prompt","id":"smoke-prompt","message":"Update Normalizer.java using native tools. Normalize whitespace and case, run the Maven tests, commit the candidate, and report completion."}'; sleep 20; } | docker run --rm -i --network "$network" \
    --cap-drop ALL --security-opt no-new-privileges --user 10001:10001 \
    -v "$fixture:/workspace/repo" --workdir /workspace/repo --entrypoint /opt/pi/node_modules/.bin/pi \
    -e HOME=/home/agent -e PI_CODING_AGENT_DIR=/state/pi -e PI_OFFLINE=1 -e PI_TELEMETRY=0 \
    -e FACTORY_MODEL_TOKEN=run-scoped-token-not-a-provider-key \
    -e GIT_AUTHOR_DATE="$fixed_git_date" -e GIT_COMMITTER_DATE="$fixed_git_date" \
    factory-pi:jdk21 --mode rpc --no-approve --no-extensions --no-skills \
    --no-prompt-templates --no-themes --no-context-files --tools read,bash,edit,write,grep,find,ls \
    --provider factory-zai --model glm-5.3-flash --session-dir /state/pi/sessions > "$raw" 2> "$STATE_DIR/logs/validation/pi-stderr.log"
  docker rm -f "$gateway" >/dev/null 2>&1 || true
  grep -q '"command":"get_state"' "$raw" || fail "Pi did not return a correlated get_state response"
  grep -q '"command":"prompt"' "$raw" || fail "Pi did not acknowledge a prompt"
  grep -q '"name":"read"\|"tool":"read"' "$raw" || fail "Pi did not use native read"
  grep -q '"name":"bash"\|"tool":"bash"' "$raw" || fail "Pi did not use native bash"
  grep -q '"type":"agent_end"' "$raw" || fail "Pi did not emit agent_end"
  grep -q '"type":"agent_settled"' "$raw" || fail "Pi did not emit agent_settled"
  candidate="$STATE_DIR/data/artifacts/pi-smoke-candidate.patch"
  candidate_head=$(git -C "$fixture" rev-parse HEAD)
  [[ "$candidate_head" != "$base" ]] || fail "Pi did not produce a candidate commit"
  grep -q 'trim().toLowerCase()' "$fixture/src/main/java/factory/Normalizer.java" || fail "Pi did not edit the normalization source"
  { git -C "$fixture" diff --binary "$base".."$candidate_head"; \
    git -C "$fixture" ls-files --others --exclude-standard | while IFS= read -r f; do git -C "$fixture" diff --binary --no-index /dev/null "$f" || [[ $? == 1 ]]; done; } > "$candidate"
  local candidate_meta="$STATE_DIR/data/artifacts/pi-smoke-candidate.json"
  printf '{"base":"%s","candidate":"%s","patchSha256":"%s"}\n' "$base" "$candidate_head" "$(sha256sum "$candidate" | cut -d' ' -f1)" > "$candidate_meta"
  git -C "$verify" clone -q "$fixture" repo
  [[ "$(git -C "$verify/repo" rev-parse HEAD)" == "$candidate_head" ]] || fail "fresh checkout identity mismatch"
  (cd "$verify/repo" && mvn -B -ntp verify) > "$STATE_DIR/logs/validation/pi-verify-mvn.log" 2>&1 || fail "independent Maven verification failed"
  local wrong="$STATE_DIR/data/sandboxes/pi-smoke-wrong.$$"
  mkdir -p "$wrong"; git -C "$wrong" clone -q "$fixture" repo
  local wrong_source="$wrong/repo/src/main/java/factory/Normalizer.java"
  sed -i.bak 's/return value.trim().toLowerCase();/return value;/' "$wrong_source"
  rm -f "$wrong_source.bak"
  if (cd "$wrong/repo" && mvn -B -ntp verify >/dev/null 2>&1); then fail "wrong candidate was accepted"; fi
  printf '%s\n' '{"status":"PASS","independent":true,"candidate":"pi-smoke-candidate.patch","candidateHead":"'"$candidate_head"'","freshCheckout":true,"mavenVerify":"pi-verify-mvn.log","wrongCandidate":"REJECTED"}' \
    > "$STATE_DIR/data/artifacts/pi-smoke-verification.json"
  {
    echo "mode=pi scripted=true provider_calls=$(wc -l < "$STATE_DIR/logs/validation/upstream-requests.jsonl") paid_calls=0 gateway=private-fixed-route"
    echo "image=factory-pi:jdk21 node=22.19.0 pi=0.85.1 network=$network non_root=true no_tty=true"
    echo "DIRECT_EGRESS=$direct_egress gateway_path=SERVING"
    echo "raw_rpc=$raw prompts=model_requests=native_read=native_bash=agent_settled"
    echo "base=$base candidateHead=$candidate_head candidate=$candidate"
    echo "verification=$STATE_DIR/data/artifacts/pi-smoke-verification.json independent=true fresh_checkout=true maven_verify=pi-verify-mvn.log wrong_candidate=rejected"
    echo "upstream_requests=$STATE_DIR/logs/validation/upstream-requests.jsonl"
    echo "artifacts=$STATE_DIR/data/artifacts"
  } | tee "$log"
  echo "Pi scripted smoke recorded: log=$log"
}

evidence_verify() {
  [[ $# == 0 ]] || fail "evidence-verify takes no arguments"
  local evidence_dir="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/evidence/M2"
  local evidence_root="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff"
  local report="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/reports/M2.md"
  local status="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/STATUS.yaml"
  [[ -f "$report" && -f "$status" ]] || fail "M2 report/status missing"
  local head
  head=$(git -C "$ROOT_DIR" rev-parse HEAD)
  local candidate_head
  candidate_head=$(sed -n 's/^Code candidate HEAD: `\([^`]*\)`.*/\1/p' "$report")
  [[ -n "$candidate_head" ]] || fail "report code candidate HEAD is missing"
  git -C "$ROOT_DIR" merge-base --is-ancestor "$candidate_head" HEAD ||
    fail "report code candidate is not an ancestor of current tree"
  grep -q '^state: COMPLETE$' "$status" || fail "STATUS.yaml is not COMPLETE"
  grep -q '^State: COMPLETE\.' "$report" || fail "report state disagrees with STATUS.yaml"
  local path
  while IFS= read -r path; do
    [[ -f "$evidence_root/$path" ]] || fail "cited evidence missing: $path"
    git -C "$ROOT_DIR" ls-files --error-unmatch "$evidence_root/$path" >/dev/null 2>&1 ||
      fail "cited evidence is untracked: $path"
  done < <(sed -n 's/.*`\(evidence\/M2\/[^`]*\)`.*/\1/p' "$report" "$status" | sort -u)
  while IFS= read -r path; do
    [[ -f "$evidence_root/$path" ]] || fail "STATUS evidence missing: $path"
    git -C "$ROOT_DIR" ls-files --error-unmatch "$evidence_root/$path" >/dev/null 2>&1 ||
      fail "STATUS evidence is untracked: $path"
  done < <(sed -n 's/^[[:space:]]*M2-C[1-7]:[[:space:]]*\(evidence\/M2\/[^[:space:]]*\).*$/\1/p' "$status" | sort -u)
  "$ROOT_DIR/scripts/factory" smoke --pi --scripted >/tmp/factory-evidence-smoke.log
  local fresh="$ROOT_DIR/.factory/data/artifacts/pi-smoke-candidate.json"
  cmp -s "$evidence_dir/candidate.json" "$fresh" || fail "candidate evidence does not match fresh smoke"
  local validation="$ROOT_DIR/.factory/logs/validation/unit-tests.txt"
  "$ROOT_DIR/scripts/factory" validate --unit >/tmp/factory-evidence-unit.log
  local fresh_count recorded_count
  fresh_count=$(sed -n 's/^TOTAL_TESTS=//p' "$validation" | tail -1)
  recorded_count=$(sed -n 's/^- `\.\/scripts\/factory validate --unit`: exit 0, \([0-9][0-9]*\) tests.*/\1/p' "$report" | head -1)
  [[ -n "$recorded_count" && "$fresh_count" == "$recorded_count" ]] ||
    fail "recorded test count $recorded_count disagrees with fresh count $fresh_count"
  echo "evidence-verify: PASS head=$head candidate=$fresh_count tests direct-egress=DENIED"
}

stop_factory() {
  if ! running_pid; then
    rm -f "$PID_FILE"
    echo "Factory is not running"
    return 0
  fi
  local pid
  pid=$(<"$PID_FILE")
  kill -TERM "$pid"
  local attempt
  for attempt in $(seq 1 30); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "Factory stopped; persistent data was preserved"
      return 0
    fi
    sleep 1
  done
  fail "Factory PID $pid did not stop after SIGTERM; inspect $APP_LOG"
}

count_reports() {
  local marker="$1"
  local total=0
  local file tests failures errors skipped
  while IFS= read -r file; do
    tests=$(sed -n 's/.*<testsuite[^>]* tests="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    failures=$(sed -n 's/.*<testsuite[^>]* failures="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    errors=$(sed -n 's/.*<testsuite[^>]* errors="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    skipped=$(sed -n 's/.*<testsuite[^>]* skipped="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    total=$((total + ${tests:-0}))
    printf '%s tests=%s failures=%s errors=%s skipped=%s\n' \
      "${file#"$ROOT_DIR/"}" "${tests:-0}" "${failures:-0}" "${errors:-0}" "${skipped:-0}"
  done < <(find "$ROOT_DIR" -path '*/target/surefire-reports/TEST-*.xml' -newer "$marker" -type f | sort)
  echo "TOTAL_TESTS=$total"
}

validate_suite() {
  local option="${1:-}"
  local suite
  case "$option" in
    --unit) suite=unit ;;
    --integration) suite=integration ;;
    --eval-pack) suite=eval-pack ;;
    *) fail "validate requires --unit, --integration, or --eval-pack" ;;
  esac
  init_factory >/dev/null
  local marker="$STATE_DIR/run/validate-${suite}.marker"
  local log="$STATE_DIR/logs/validation/${suite}.log"
  local summary="$STATE_DIR/logs/validation/${suite}-tests.txt"
  touch "$marker"
  if [[ "$suite" == integration ]]; then
    docker info >/dev/null 2>&1 || fail "integration suite requires Docker (BLOCKED_REQUIRES_DOCKER)"
    docker image inspect factory-pi:jdk21 >/dev/null 2>&1 ||
      docker build -q -t factory-pi:jdk21 "$ROOT_DIR/factory-sandbox"
  fi
  local rc=0
  (
    cd "$ROOT_DIR"
    export MAVEN_USER_HOME="$STATE_DIR/cache/maven-home"
    case "$suite" in
      unit) ./mvnw test -B '-Dgroups=!integration & !eval-pack & !live' ;;
      integration) ./mvnw test -B -Dgroups=integration -Dsurefire.failIfNoSpecifiedTests=false ;;
      eval-pack) ./mvnw test -B -Dgroups=eval-pack -Dsurefire.failIfNoSpecifiedTests=false ;;
    esac
  ) > "$log" 2>&1 || rc=$?
  count_reports "$marker" | tee "$summary"
  local total
  total=$(sed -n 's/^TOTAL_TESTS=//p' "$summary")
  [[ "$total" =~ ^[1-9][0-9]*$ ]] || fail "$suite selected zero tests; see $log"
  [[ "$rc" == 0 ]] || fail "$suite validation failed with exit $rc; see $log"
  if [[ "$suite" == integration ]]; then
    grep -q 'SandboxServiceIntegrationTest' "$summary" || fail "real Docker integration test was not selected"
  elif [[ "$suite" == eval-pack ]]; then
    grep -q 'EvalPackHermeticRegressionFixTest' "$summary" || fail "eval regression scenario missing"
    grep -q 'EvalPackHermeticCounterexampleTest' "$summary" || fail "eval counterexample scenario missing"
    grep -q 'EvalPackHermeticSummaryTest' "$summary" || fail "eval summary scenario missing"
  else
    grep -q 'CodingHarnessTest' "$summary" || fail "harness unit tests were not selected"
    grep -q 'AnthropicApiKeyGuardTest' "$summary" || fail "startup guard unit tests were not selected"
  fi
  echo "$suite validation passed: $total tests; log=$log; selection=$summary"
}

require_task_file() {
  local task_file="$1"
  [[ -f "$task_file" && ! -L "$task_file" ]] || fail "task input must be a regular non-symlink file"
  local size
  size=$(wc -c < "$task_file" | tr -d ' ')
  [[ "$size" -le 262144 ]] || fail "task input exceeds the 256 KiB limit"
}

resolve_task() {
  [[ $# == 1 ]] || fail "resolve-task requires one YAML or JSON task file"
  require_task_file "$1"
  load_config
  curl --fail-with-body -sS -H 'Content-Type: application/yaml' \
    -H "X-Task-Name: $(basename "$1")" --data-binary "@$1" \
    "http://127.0.0.1:${FACTORY_APP_PORT}/api/dev/tasks/resolve"
  printf '\n'
}

submit_task() {
  [[ $# == 1 ]] || fail "submit requires one YAML or JSON task file"
  require_task_file "$1"
  local inbox="$STATE_DIR/data/inbox"
  mkdir -p "$inbox"
  chmod 700 "$inbox"
  local name
  name=$(basename "$1")
  case "$name" in
    *.yaml|*.yml|*.json|*.YAML|*.YML|*.JSON) ;;
    *) fail "task filename must end in .yaml, .yml, or .json" ;;
  esac
  local final="$inbox/$name"
  [[ ! -e "$final" && ! -e "$final.partial" ]] || fail "inbox already contains $name"
  cp -- "$1" "$final.partial"
  chmod 600 "$final.partial"
  mv -- "$final.partial" "$final"
  echo "Task submitted atomically to $final"
}

command="${1:-}"
shift || true
case "$command" in
  init) [[ $# == 0 ]] || fail "init takes no arguments"; init_factory ;;
  infra) infra "$@" ;;
  doctor) [[ "${1:-}" == --offline && $# == 1 ]] || fail "doctor requires --offline"; doctor_offline ;;
  start) start_factory "$@" ;;
  stop) [[ $# == 0 ]] || fail "stop takes no arguments"; stop_factory ;;
  validate) validate_suite "$@" ;;
  smoke) smoke_pi_scripted "$@" ;;
  evidence-verify) evidence_verify "$@" ;;
  resolve-task) resolve_task "$@" ;;
  submit) submit_task "$@" ;;
  *) usage; exit 1 ;;
esac
