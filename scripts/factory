#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE_DIR="$ROOT_DIR/.factory"
CONFIG_FILE="$STATE_DIR/config/factory.env"
PASSWORD_FILE="$STATE_DIR/secrets/postgres-password"
MODEL_TOKEN_FILE="$STATE_DIR/secrets/model-run-token"
PID_FILE="$STATE_DIR/run/factory.pid"
APP_LOG="$STATE_DIR/logs/factory.log"

fail() {
  echo "factory: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  ./scripts/factory init
  ./scripts/factory infra up|down
  ./scripts/factory doctor --offline|--live
  ./scripts/factory start --mode offline|live|pi
  ./scripts/factory smoke --pi --scripted
  ./scripts/factory evidence-verify
  ./scripts/factory stop
  ./scripts/factory validate --unit|--integration|--eval-pack|--gateway
  ./scripts/factory resolve-task TASK.yaml
  ./scripts/factory submit TASK.yaml
  ./scripts/factory run-eval TASK_ID --run-key RUN_KEY [--delivery-mode LOCAL_ONLY|DELIVER_PR]    # curated: MODSIDECAR-208, MGRENTITLE-161/172/192, MODROLESKC-424/427, MODSCHED-70/76; derived: MODSIDECAR-207
  ./scripts/factory show EXECUTION_ID [--watch]
  ./scripts/factory decide EXECUTION_ID --decision-id ID (--option OPTION_ID | --free-text TEXT) --reviewer NAME [--comment TEXT]
  ./scripts/factory export EXECUTION_ID --out DIRECTORY
  ./scripts/factory deliver EXECUTION_ID    # trusted branch/push/PR of a completed SUCCESS execution
EOF
}

require_init() {
  [[ -f "$CONFIG_FILE" && -f "$PASSWORD_FILE" && -f "$MODEL_TOKEN_FILE" ]] ||
    fail "not initialized; run ./scripts/factory init"
}

load_config() {
  require_init
  load_dotenv_file "$ROOT_DIR/.env"
  load_dotenv_file "$CONFIG_FILE"
  : "${FACTORY_POSTGRES_PORT:=55432}"
  : "${FACTORY_APP_PORT:=18080}"
  : "${FACTORY_GATEWAY_PORT:=18081}"
  : "${FACTORY_MODEL_PROVIDER:=factory-zai}"
  : "${FACTORY_MODEL_BASE_URL:=https://api.z.ai/api/paas/v4}"
  : "${FACTORY_MODEL_ID:=glm-5.3-flash}"
  : "${FACTORY_MODEL_THINKING:=high}"
  : "${FACTORY_MODEL_CONTEXT_TOKENS:=65536}"
  : "${FACTORY_MODEL_MAX_OUTPUT_TOKENS:=16384}"
  : "${FACTORY_ALLOW_UNPRICED:=true}"
  if [[ -z "${FACTORY_MODEL_API_KEY:-}" && -n "${GLM_API_KEY:-}" ]]; then
    FACTORY_MODEL_API_KEY="$GLM_API_KEY"
  fi
  # This is a Factory-owned per-run credential.  Always use the current
  # protected file so a stale caller environment cannot keep doctor or
  # teardown pointed at a revoked token after rotation.
  FACTORY_MODEL_TOKEN=$(<"$MODEL_TOKEN_FILE")
  export FACTORY_POSTGRES_PORT FACTORY_APP_PORT FACTORY_GATEWAY_PORT
  export FACTORY_MODEL_PROVIDER FACTORY_MODEL_BASE_URL FACTORY_MODEL_ID
  export FACTORY_MODEL_THINKING FACTORY_MODEL_CONTEXT_TOKENS FACTORY_MODEL_MAX_OUTPUT_TOKENS FACTORY_ALLOW_UNPRICED
  export FACTORY_MODEL_API_KEY FACTORY_MODEL_TOKEN
  export DOCKER_CONFIG="${DOCKER_CONFIG:-$STATE_DIR/cache/docker-config}"
  # Gateway containers run as the invoking user so the bind-mounted evidence
  # directory (.factory/logs/runs, 0700) stays writable by their process.
  : "${FACTORY_GATEWAY_UID:=$(id -u)}"
  : "${FACTORY_GATEWAY_GID:=$(id -g)}"
  export FACTORY_GATEWAY_UID FACTORY_GATEWAY_GID
}

load_dotenv_file() {
  local file="$1" line key value
  [[ -f "$file" && ! -L "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    key="${key##+([[:space:]])}"
    key="${key%%+([[:space:]])}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "invalid dotenv key in $file"
    # The caller's environment wins over both dotenv files.  Values are data;
    # they are never evaluated as shell syntax.
    if [[ -z "${!key+x}" ]]; then
      value="${value##+([[:space:]])}"
      value="${value%%+([[:space:]])}"
      if [[ "$value" == \"*\" && "$value" == *\" ]]; then
        value="${value:1:${#value}-2}"
      elif [[ "$value" == \'.*\' && "$value" == *\' ]]; then
        value="${value:1:${#value}-2}"
      fi
      printf -v "$key" '%s' "$value"
      export "$key"
    fi
  done < "$file"
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

init_factory() {
  umask 077
  mkdir -p "$STATE_DIR/config" "$STATE_DIR/secrets" "$STATE_DIR/data/postgres" \
    "$STATE_DIR/data/artifacts" "$STATE_DIR/data/recovery" "$STATE_DIR/data/inbox" \
    "$STATE_DIR/data/sandboxes" "$STATE_DIR/cache/maven-home" \
    "$STATE_DIR/cache/host-maven-repository" "$STATE_DIR/cache/sandbox-maven-repository" \
    "$STATE_DIR/cache/docker-config" \
    "$STATE_DIR/logs/validation" \
    "$STATE_DIR/logs/runs" \
    "$STATE_DIR/run"
  find "$STATE_DIR" -type d -exec chmod 700 {} + 2>/dev/null || true
  if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '%s\n' 'FACTORY_POSTGRES_PORT=55432' 'FACTORY_APP_PORT=18080' \
      'FACTORY_GATEWAY_PORT=18081' > "$CONFIG_FILE"
  else
    grep -q '^FACTORY_GATEWAY_PORT=' "$CONFIG_FILE" ||
      printf '%s\n' 'FACTORY_GATEWAY_PORT=18081' >> "$CONFIG_FILE"
  fi
  if [[ ! -f "$PASSWORD_FILE" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      openssl rand -hex 24 > "$PASSWORD_FILE"
    else
      fail "openssl is required to create the local PostgreSQL password"
    fi
  fi
  if [[ ! -f "$MODEL_TOKEN_FILE" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      openssl rand -hex 32 > "$MODEL_TOKEN_FILE"
    else
      fail "openssl is required to create the local Pi run token"
    fi
  fi
  chmod 600 "$CONFIG_FILE" "$PASSWORD_FILE" "$MODEL_TOKEN_FILE"
  if [[ -f "$ROOT_DIR/.env" ]]; then
    [[ ! -L "$ROOT_DIR/.env" ]] || fail ".env must not be a symbolic link"
    chmod 600 "$ROOT_DIR/.env"
  fi
  echo "Factory state initialized at $STATE_DIR"
}

rotate_model_token() {
  command -v openssl >/dev/null 2>&1 || fail "openssl is required to rotate the local Pi run token"
  local token
  token=$(openssl rand -hex 32) || fail "could not generate a local Pi run token"
  (umask 077; printf '%s\n' "$token" > "$MODEL_TOKEN_FILE")
  chmod 600 "$MODEL_TOKEN_FILE"
  FACTORY_MODEL_TOKEN="$token"
  export FACTORY_MODEL_TOKEN
}

compose() {
  load_config
  if command -v docker-compose >/dev/null 2>&1; then
    (cd "$ROOT_DIR" && docker-compose "$@")
  else
    (cd "$ROOT_DIR" && docker compose "$@")
  fi
}

infra() {
  case "${1:-}" in
    up)
      guard_legacy_pgdata
      compose up -d --wait postgres
      ;;
    down)
      compose down
      ;;
    *) fail "infra requires up or down" ;;
  esac
}

doctor_offline() {
  load_config
  command -v java >/dev/null || fail "Java 21 is required"
  [[ $(java -version 2>&1 | head -1) == *'21.'* ]] || fail "Java 21 is required"
  [[ -x "$ROOT_DIR/mvnw" ]] || fail "the pinned Maven Wrapper is missing or not executable"
  command -v docker >/dev/null || fail "Docker is required for PostgreSQL"
  docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable (BLOCKED_REQUIRES_DOCKER)"
  compose ps --status running postgres | grep -q postgres ||
    fail "PostgreSQL is not running; run ./scripts/factory infra up"
  [[ $(file_mode "$STATE_DIR") == 700 ]] || fail "$STATE_DIR must have mode 0700"
  [[ $(file_mode "$CONFIG_FILE") == 600 ]] || fail "$CONFIG_FILE must have mode 0600"
  [[ $(file_mode "$PASSWORD_FILE") == 600 ]] || fail "$PASSWORD_FILE must have mode 0600"
  echo "Offline doctor: OK (Java 21, wrapper, Docker, PostgreSQL, permissions)"
  echo "Offline model: scripted local ChatModel; API credentials are not read"
}

effective_config() {
  local key_state=missing
  [[ -n "${FACTORY_MODEL_API_KEY:-}" ]] && key_state=configured
  echo "Effective Pi config: provider=$FACTORY_MODEL_PROVIDER model=$FACTORY_MODEL_ID thinking=$FACTORY_MODEL_THINKING"
  echo "Effective Pi limits: context=${FACTORY_MODEL_CONTEXT_TOKENS:-65536} max_output=$FACTORY_MODEL_MAX_OUTPUT_TOKENS allow_unpriced=$FACTORY_ALLOW_UNPRICED"
  echo "Effective upstream: base_url=$FACTORY_MODEL_BASE_URL api_key=$key_state gateway=http://127.0.0.1:${FACTORY_GATEWAY_PORT}"
  if [[ -n "${FACTORY_LLM_BASE_URL:-}" || -n "${FACTORY_LLM_MODEL:-}" ]]; then
    echo "Inactive legacy settings detected: FACTORY_LLM_* are not used by Pi mode"
  fi
}

doctor_live() {
  load_config
  [[ -n "${FACTORY_MODEL_API_KEY:-}" ]] ||
    fail "live preflight requires FACTORY_MODEL_API_KEY or GLM_API_KEY; no provider request was made"
  [[ -n "${FACTORY_MODEL_TOKEN:-}" ]] || fail "Pi run token is missing; run ./scripts/factory init"
  effective_config
  local gateway="http://127.0.0.1:${FACTORY_GATEWAY_PORT}"
  curl -fsS "$gateway/health" >/dev/null ||
    fail "Pi gateway is not reachable; start Factory with --mode pi before the live doctor"
  local stamp out text_request tool_request final_request
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  out="$STATE_DIR/logs/runs/preflight-${stamp}.jsonl"
  : > "$out"
  text_request=$(python3 - "$FACTORY_MODEL_ID" <<'PY'
import json, sys
print(json.dumps({"model": sys.argv[1], "messages": [{"role": "user", "content": "Reply with exactly READY."}], "max_tokens": 64, "stream": False}))
PY
)
  tool_request=$(python3 - "$FACTORY_MODEL_ID" <<'PY'
import json, sys
print(json.dumps({"model": sys.argv[1], "messages": [{"role": "user", "content": "Use the probe tool once."}], "tools": [{"type": "function", "function": {"name": "probe", "description": "Return a fixed readiness value", "parameters": {"type": "object", "properties": {}}}}], "tool_choice": {"type": "function", "function": {"name": "probe"}}, "max_tokens": 128, "stream": False}))
PY
)
  final_request=$(python3 - "$FACTORY_MODEL_ID" <<'PY'
import json, sys
print(json.dumps({"model": sys.argv[1], "messages": [{"role": "user", "content": "Use the probe tool once."}, {"role": "assistant", "tool_calls": [{"id": "preflight-probe", "type": "function", "function": {"name": "probe", "arguments": "{}"}}]}, {"role": "tool", "tool_call_id": "preflight-probe", "content": "READY"}, {"role": "user", "content": "Now reply with exactly READY."}], "max_tokens": 128, "stream": False}))
PY
)
  local index=0 response
  for response_body in "$text_request" "$tool_request" "$final_request"; do
    index=$((index + 1))
    response=$(curl --fail-with-body --max-time 300 -sS \
      -H "Authorization: Bearer $FACTORY_MODEL_TOKEN" \
      -H 'Content-Type: application/json' \
      -d "$response_body" "$gateway/v1/chat/completions") ||
      fail "live preflight request $index failed; retained $out and made no benchmark request"
    python3 - "$index" "$FACTORY_MODEL_ID" "$response" >> "$out" <<'PY'
import json, sys
index, expected, raw = sys.argv[1:]
try:
    body = json.loads(raw)
except json.JSONDecodeError as error:
    raise SystemExit(f"response is not valid JSON: {error}")
if not isinstance(body, dict):
    raise SystemExit("response is not a JSON object")
reported = body.get("model")
if reported is not None and reported != expected:
    raise SystemExit(f"reported model mismatch: {reported} != {expected}")
choices = body.get("choices")
if not isinstance(choices, list) or not choices:
    raise SystemExit("response has no choices")
usage = body.get("usage")
if not isinstance(usage, dict):
    raise SystemExit("response has no usage object")
if not isinstance(choices[0], dict):
    raise SystemExit("response choice is not an object")
message = choices[0].get("message")
if not isinstance(message, dict):
    raise SystemExit("response choice has no message")
if int(index) in (1, 3):
    content = message.get("content")
    if not isinstance(content, str) or content.strip() != "READY":
        raise SystemExit(f"request {index} did not return exactly READY")
if int(index) == 2:
    calls = message.get("tool_calls")
    if not isinstance(calls, list) or not any(
        isinstance(call, dict)
        and isinstance(call.get("function"), dict)
        and call["function"].get("name") == "probe"
        for call in calls
    ):
        raise SystemExit("tool preflight did not return the probe tool call")
print(json.dumps({"request": int(index), "json": True, "reported_model": reported,
                  "usage": usage, "choices": len(choices)}))
PY
  done
  chmod 600 "$out"
  echo "Live preflight: PASS (3 bounded requests: text, tool call, tool-result replay); evidence=$out"
}

running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid=$(<"$PID_FILE")
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if ps -p "$pid" -o command= 2>/dev/null | grep -q 'factory-app.*\.jar'; then
    return 0
  fi
  command -v lsof >/dev/null &&
    lsof -nP -p "$pid" 2>/dev/null | grep '/factory-app/target/factory-app-.*\.jar' >/dev/null
}

start_factory() {
  [[ "${1:-}" == "--mode" ]] || fail "start requires --mode offline, live, or pi"
  local mode="${2:-}"
  [[ "$mode" == offline || "$mode" == live || "$mode" == pi ]] || fail "mode must be offline, live, or pi"
  load_config
  if running_pid; then
    fail "Factory is already running with PID $(<"$PID_FILE")"
  fi
  if curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/actuator/health" >/dev/null 2>&1; then
    fail "another Factory instance is already listening on 127.0.0.1:${FACTORY_APP_PORT}"
  fi
  rm -f "$PID_FILE"
  # Migrate an empty directory lock left by a hard-killed pre-flock start.
  if [[ -d "$STATE_DIR/run/start.lock" ]]; then
    rmdir "$STATE_DIR/run/start.lock" 2>/dev/null ||
      fail "stale directory start lock cannot be removed; inspect $STATE_DIR/run/start.lock"
  fi
  # Whole-launcher advisory lock: the kernel releases it when this process
  # dies, so a hard-killed start cannot permanently block the next one.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE_DIR/run/start.lock" || fail "cannot open the Factory start lock"
    flock -n 9 || fail "another Factory start is in progress"
  else
    # Hosts without util-linux flock (e.g. macOS): an atomic directory lock
    # at a separate path.  Every exit path of start removes it, matching the
    # fd-release semantics above; a hard-killed start leaves an empty
    # directory which the next start reclaims.
    START_DIRLOCK="$STATE_DIR/run/start.dirlock"
    if ! mkdir "$START_DIRLOCK" 2>/dev/null; then
      rmdir "$START_DIRLOCK" 2>/dev/null ||
        fail "another Factory start is in progress"
      mkdir "$START_DIRLOCK" 2>/dev/null ||
        fail "another Factory start is in progress"
    fi
  fi
  local pi_gateways_started=false
  trap 'if [[ "${pi_gateways_started:-}" == true ]]; then revoke_pi_gateways; fi; if [[ -n "${START_DIRLOCK:-}" ]]; then rmdir "$START_DIRLOCK" 2>/dev/null || true; fi' EXIT

  if [[ "$mode" == offline ]]; then
    doctor_offline
  elif [[ "$mode" == live && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    fail "live mode requires ANTHROPIC_API_KEY; no provider request was made"
  elif [[ "$mode" == pi && -z "${FACTORY_MODEL_API_KEY:-}" ]]; then
    fail "pi mode requires FACTORY_MODEL_API_KEY or GLM_API_KEY; no provider request was made"
  elif [[ "$mode" == pi ]]; then
    [[ "$FACTORY_MODEL_PROVIDER" == factory-zai ]] ||
      fail "pi mode only permits the trusted provider factory-zai"
    # Trusted z.ai models on the coding endpoint: glm-5.3-flash (default)
    # and glm-5.3 (dataset v3 upgrade for Medium/High, 2026-09-12).
    case "$FACTORY_MODEL_ID" in
      glm-5.3|glm-5.3-flash) ;;
      *) fail "pi mode only permits trusted models glm-5.3 / glm-5.3-flash" ;;
    esac
    guard_legacy_pgdata
    rotate_model_token
    # The coding gateway budgets and times out each Developer Flow execution
    # separately (FACTORY_MAX_ATTEMPTS, FACTORY_EXECUTION_TTL_SECONDS from the
    # execution's first model call), so no process-wide expiry is set here.
    export FACTORY_PI_GATEWAY_URL="http://127.0.0.1:${FACTORY_GATEWAY_PORT}/v1"
    pi_gateways_started=true
    compose up -d --build --force-recreate --wait postgres factory-gateway factory-dependency-gateway
    docker build -q -t factory-pi:jdk21 "$ROOT_DIR/factory-sandbox"
    # Fail fast if the gateways cannot record their evidence volume: a silent
    # evidence failure would make live provider calls unauditable.
    compose exec -T factory-gateway touch /evidence/.write-probe >/dev/null 2>&1 ||
      fail "coding gateway cannot write its evidence volume (.factory/logs/runs)"
    compose exec -T factory-gateway rm -f /evidence/.write-probe >/dev/null 2>&1 || true
    compose exec -T factory-dependency-gateway touch /evidence/.write-probe >/dev/null 2>&1 ||
      fail "dependency gateway cannot write its evidence volume (.factory/logs/runs)"
    compose exec -T factory-dependency-gateway rm -f /evidence/.write-probe >/dev/null 2>&1 || true
    effective_config
  fi

  (cd "$ROOT_DIR" && export MAVEN_USER_HOME="$STATE_DIR/cache/maven-home" && \
    ./mvnw -B -pl factory-app -am package -DskipTests)
  local jar="$ROOT_DIR/factory-app/target/factory-app-0.1.0-SNAPSHOT.jar"
  [[ -f "$jar" ]] || fail "application jar was not built: $jar"
  local db_password
  db_password=$(<"$PASSWORD_FILE")
  : > "$APP_LOG"
  (
    export SPRING_PROFILES_ACTIVE="$mode"
    export FACTORY_MODE="$mode"
    export FACTORY_APP_PORT FACTORY_POSTGRES_PORT
    export FACTORY_DATA_DIR="$STATE_DIR/data"
    export FACTORY_SANDBOX_MAVEN_REPOSITORY="$STATE_DIR/cache/sandbox-maven-repository"
    export FACTORY_DB_URL="jdbc:postgresql://127.0.0.1:${FACTORY_POSTGRES_PORT}/factory"
    export FACTORY_DB_USER=factory
    export FACTORY_DB_PASSWORD="$db_password"
    export FACTORY_EXTERNAL_WRITES_ENABLED=false
    if [[ "$mode" == pi ]]; then export FACTORY_INBOX_EVENT_TYPE=file.inbox.pi; fi
    if [[ "$mode" == offline || "$mode" == pi ]]; then
        unset ANTHROPIC_API_KEY GLM_API_KEY FACTORY_MODEL_API_KEY
        unset FACTORY_LLM_BASE_URL FACTORY_LLM_MODEL
    fi
    exec nohup java -jar "$jar"
  ) >> "$APP_LOG" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  chmod 600 "$PID_FILE" "$APP_LOG"

  local attempt
  for attempt in $(seq 1 90); do
    if curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/actuator/health" >/dev/null 2>&1; then
      pi_gateways_started=false
      if [[ -n "${START_DIRLOCK:-}" ]]; then rmdir "$START_DIRLOCK" 2>/dev/null || true; fi
      trap - EXIT
      echo "Factory is ready in $mode mode at http://127.0.0.1:${FACTORY_APP_PORT} (PID $pid)"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      tail -40 "$APP_LOG" >&2
      fail "Factory exited before readiness"
    fi
    sleep 1
  done
  stop_factory || true
  revoke_pi_gateways
  tail -40 "$APP_LOG" >&2
  fail "Factory did not become ready within 90 seconds"
}

smoke_remove_workspace() {
  local dir="$1"
  [[ -n "$dir" && "$dir" == "$STATE_DIR"/data/sandboxes/* ]] || return 0
  [[ -e "$dir" ]] || return 0
  rm -rf -- "$dir" 2>/dev/null || true
  if [[ -e "$dir" ]]; then
    # Pi commits into the mounted fixture as uid 10001; reclaim permission
    # through a root helper container when the host user cannot remove
    # container-owned git objects.
    docker run --rm -v "$dir:/reclaim" alpine:3.20 \
      chmod -R u+rwX,go+rwX /reclaim >/dev/null 2>&1 || true
    rm -rf -- "$dir" 2>/dev/null || true
  fi
}

smoke_cleanup_all() {
  local dir
  for dir in ${SMOKE_WORKSPACES[@]+"${SMOKE_WORKSPACES[@]}"}; do
    smoke_remove_workspace "$dir"
  done
}

smoke_pi_scripted() {
  [[ $# == 2 && "$1" == --pi && "$2" == --scripted ]] || fail "smoke requires --pi --scripted"
  init_factory >/dev/null
  load_config
  command -v docker >/dev/null || fail "Docker is required for Pi smoke"
  docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable (BLOCKED_REQUIRES_DOCKER)"
  local log="$STATE_DIR/logs/validation/pi-smoke.log"
  mkdir -p "$(dirname "$log")"
  docker build -q -t factory-pi:jdk21 "$ROOT_DIR/factory-sandbox" >> "$log"
  local network="factory-pi-smoke-$$"
  docker network create --internal --driver bridge "$network" >> "$log"
  # The cleanup trap runs at script exit, after this function's locals are
  # gone, so the network and transient workspaces are tracked in globals.
  # Every smoke run removes the fixture/verify/wrong workspaces it created
  # (M4 stabilization: no run-to-run residue in the sandbox data directory).
  SMOKE_NETWORK="$network"
  SMOKE_WORKSPACES=()
  trap 'smoke_cleanup_all; docker network rm "$SMOKE_NETWORK" >/dev/null 2>&1 || true' EXIT
  local gateway
  gateway=$(docker run -d --rm --network "$network" --network-alias factory-gateway --name "${network}-gateway" \
    -v "$STATE_DIR/logs/validation:/evidence" python:3.12-alpine python -c 'import json
from http.server import BaseHTTPRequestHandler,HTTPServer
log=open("/evidence/upstream-requests.jsonl","w")
class H(BaseHTTPRequestHandler):
  def log_message(self,*a): pass
  def do_GET(self):
    if self.path == "/health": self.send_response(200); self.end_headers(); self.wfile.write(b"ok")
    else: self.send_error(404)
  def do_POST(self):
    if self.path != "/v1/chat/completions": self.send_error(404); return
    n=int(self.headers.get("Content-Length",0)); body=json.loads(self.rfile.read(n)); messages=body.get("messages",[])
    log.write(json.dumps({"model":body.get("model"),"messageCount":len(messages),"messageRoles":[m.get("role") for m in messages],"hasTools":bool(body.get("tools")),"toolStream":body.get("tool_stream"),"thinkingFields":sorted(k for k in body if "think" in k.lower() or "reason" in k.lower())})+"\n"); log.flush()
    tool_count=sum(1 for m in messages if m.get("role")=="tool")
    if tool_count == 0:
      msg={"role":"assistant","content":None,"tool_calls":[{"id":"read-1","type":"function","function":{"name":"read","arguments":json.dumps({"path":"README.md"})}}]}
    elif tool_count == 1:
      msg={"role":"assistant","content":None,"tool_calls":[{"id":"bash-1","type":"function","function":{"name":"bash","arguments":json.dumps({"command":"git config --global --add safe.directory /workspace/repo && sed -i \"s/return value;/return value.trim().toLowerCase();/\" src/main/java/factory/Normalizer.java && git add . && git commit -m pi-normalization-candidate"})}}]}
    else: msg={"role":"assistant","content":"Pi completed the requested fixture change."}
    delta={"role":"assistant"} if msg.get("tool_calls") else {"content":msg.get("content","")}
    if msg.get("tool_calls"): delta["tool_calls"]=[{"index":0,"id":msg["tool_calls"][0]["id"],"type":"function","function":{"name":msg["tool_calls"][0]["function"]["name"],"arguments":msg["tool_calls"][0]["function"]["arguments"]}}]
    chunks=[{"id":"scripted","choices":[{"index":0,"delta":delta,"finish_reason":None}]},{"id":"scripted","choices":[{"index":0,"delta":{},"finish_reason":"tool_calls" if msg.get("tool_calls") else "stop"}]}]
    self.send_response(200); self.send_header("Content-Type","text/event-stream"); self.send_header("Cache-Control","no-cache"); self.end_headers()
    for chunk in chunks: self.wfile.write(("data: "+json.dumps(chunk)+"\n\n").encode()); self.wfile.flush()
    self.wfile.write(b"data: [DONE]\n\n"); self.wfile.flush()
HTTPServer(("0.0.0.0",8080),H).serve_forever()')
  for _ in $(seq 1 20); do
    docker run --rm --network "$network" python:3.12-alpine python -c 'import urllib.request; urllib.request.urlopen("http://factory-gateway:8080/health")' >/dev/null 2>&1 && break
    sleep 0.2
  done
  local direct_egress=ALLOWED
  if ! docker run --rm --network "$network" --network-alias direct-probe python:3.12-alpine \
      python -c 'import urllib.request; urllib.request.urlopen("https://example.com", timeout=2)' \
      >/dev/null 2>&1; then direct_egress=DENIED; fi
  [[ "$direct_egress" == DENIED ]] || fail "sandbox network permits direct egress"
  local fixture
  local fixed_git_date="2020-01-01T00:00:00Z"
  fixture=$(mktemp -d "$STATE_DIR/data/sandboxes/pi-smoke-fixture.XXXXXX")
  SMOKE_WORKSPACES+=("$fixture")
  local verify="$STATE_DIR/data/sandboxes/pi-smoke-verify.$$"
  mkdir -p "$verify"
  SMOKE_WORKSPACES+=("$verify")
  git -C "$fixture" init -q -b main
  git -C "$fixture" config user.name Factory-Smoke; git -C "$fixture" config user.email smoke@factory.invalid
  mkdir -p "$fixture/src/main/java/factory" "$fixture/src/test/java/factory"
  printf '%s\n' '# Pi normalization fixture' 'The candidate must normalize input.' > "$fixture/README.md"
  cat > "$fixture/pom.xml" <<'EOF'
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion><groupId>factory</groupId><artifactId>pi-fixture</artifactId><version>1</version><properties><maven.compiler.release>21</maven.compiler.release><maven.compiler.source>21</maven.compiler.source><maven.compiler.target>21</maven.compiler.target><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties><dependencies><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.0</version><scope>test</scope></dependency></dependencies><build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin></plugins></build></project>
EOF
  printf '%s\n' 'package factory;' 'public final class Normalizer {' '  private Normalizer() {}' '  public static String normalize(String value) { return value; }' '}' > "$fixture/src/main/java/factory/Normalizer.java"
  printf '%s\n' 'package factory;' 'import static org.junit.jupiter.api.Assertions.assertEquals;' 'import org.junit.jupiter.api.Test;' 'class NormalizerTest {' '  @Test void normalizesWhitespaceAndCase() {' '    assertEquals("folio", Normalizer.normalize("  FOLIO  "));' '  }' '}' > "$fixture/src/test/java/factory/NormalizerTest.java"
  git -C "$fixture" add .; GIT_AUTHOR_DATE="$fixed_git_date" GIT_COMMITTER_DATE="$fixed_git_date" \
    git -C "$fixture" commit -q -m base
  chmod -R a+rwX "$fixture"
  local base candidate_head candidate
  base=$(git -C "$fixture" rev-parse HEAD)
  local raw="$STATE_DIR/logs/validation/pi-rpc.jsonl"
  : > "$raw"
  { printf '%s\n' '{"type":"get_state","id":"smoke-state"}' '{"type":"prompt","id":"smoke-prompt","message":"Update Normalizer.java using native tools. Normalize whitespace and case, run the Maven tests, commit the candidate, and report completion."}'; sleep 20; } | docker run --rm -i --network "$network" \
    --cap-drop ALL --security-opt no-new-privileges --user 10001:10001 \
    -v "$fixture:/workspace/repo" --workdir /workspace/repo --entrypoint /opt/pi/node_modules/.bin/pi \
    -e HOME=/home/agent -e PI_CODING_AGENT_DIR=/state/pi -e PI_OFFLINE=1 -e PI_TELEMETRY=0 \
    -e FACTORY_MODEL_TOKEN=run-scoped-token-not-a-provider-key \
    -e GIT_AUTHOR_DATE="$fixed_git_date" -e GIT_COMMITTER_DATE="$fixed_git_date" \
    factory-pi:jdk21 --mode rpc --no-approve --no-extensions --no-skills \
    --no-prompt-templates --no-themes --no-context-files --tools read,bash,edit,write,grep,find,ls \
    --provider factory-zai --model glm-5.3-flash --session-dir /state/pi/sessions > "$raw" 2> "$STATE_DIR/logs/validation/pi-stderr.log"
  docker rm -f "$gateway" >/dev/null 2>&1 || true
  grep -q '"command":"get_state"' "$raw" || fail "Pi did not return a correlated get_state response"
  grep -q '"command":"prompt"' "$raw" || fail "Pi did not acknowledge a prompt"
  grep -q '"name":"read"\|"tool":"read"' "$raw" || fail "Pi did not use native read"
  grep -q '"name":"bash"\|"tool":"bash"' "$raw" || fail "Pi did not use native bash"
  grep -q '"type":"agent_end"' "$raw" || fail "Pi did not emit agent_end"
  grep -q '"type":"agent_settled"' "$raw" || fail "Pi did not emit agent_settled"
  candidate="$STATE_DIR/data/artifacts/pi-smoke-candidate.patch"
  candidate_head=$(git -C "$fixture" rev-parse HEAD)
  [[ "$candidate_head" != "$base" ]] || fail "Pi did not produce a candidate commit"
  grep -q 'trim().toLowerCase()' "$fixture/src/main/java/factory/Normalizer.java" || fail "Pi did not edit the normalization source"
  { git -C "$fixture" diff --binary "$base".."$candidate_head"; \
    git -C "$fixture" ls-files --others --exclude-standard | while IFS= read -r f; do git -C "$fixture" diff --binary --no-index /dev/null "$f" || [[ $? == 1 ]]; done; } > "$candidate"
  local candidate_meta="$STATE_DIR/data/artifacts/pi-smoke-candidate.json"
  printf '{"base":"%s","candidate":"%s","patchSha256":"%s"}\n' "$base" "$candidate_head" "$(sha256sum "$candidate" | cut -d' ' -f1)" > "$candidate_meta"
  git -C "$verify" clone -q "$fixture" repo
  [[ "$(git -C "$verify/repo" rev-parse HEAD)" == "$candidate_head" ]] || fail "fresh checkout identity mismatch"
  (cd "$verify/repo" && mvn -B -ntp verify) > "$STATE_DIR/logs/validation/pi-verify-mvn.log" 2>&1 || fail "independent Maven verification failed"
  local wrong="$STATE_DIR/data/sandboxes/pi-smoke-wrong.$$"
  mkdir -p "$wrong"
  SMOKE_WORKSPACES+=("$wrong")
  git -C "$wrong" clone -q "$fixture" repo
  local wrong_source="$wrong/repo/src/main/java/factory/Normalizer.java"
  sed -i.bak 's/return value.trim().toLowerCase();/return value;/' "$wrong_source"
  rm -f "$wrong_source.bak"
  if (cd "$wrong/repo" && mvn -B -ntp verify >/dev/null 2>&1); then fail "wrong candidate was accepted"; fi
  printf '%s\n' '{"status":"PASS","independent":true,"candidate":"pi-smoke-candidate.patch","candidateHead":"'"$candidate_head"'","freshCheckout":true,"mavenVerify":"pi-verify-mvn.log","wrongCandidate":"REJECTED"}' \
    > "$STATE_DIR/data/artifacts/pi-smoke-verification.json"
  {
    echo "mode=pi scripted=true provider_calls=$(wc -l < "$STATE_DIR/logs/validation/upstream-requests.jsonl") paid_calls=0 gateway=private-fixed-route"
    echo "image=factory-pi:jdk21 node=22.19.0 pi=0.85.1 network=$network non_root=true no_tty=true"
    echo "DIRECT_EGRESS=$direct_egress gateway_path=SERVING"
    echo "raw_rpc=$raw prompts=model_requests=native_read=native_bash=agent_settled"
    echo "base=$base candidateHead=$candidate_head candidate=$candidate"
    echo "verification=$STATE_DIR/data/artifacts/pi-smoke-verification.json independent=true fresh_checkout=true maven_verify=pi-verify-mvn.log wrong_candidate=rejected"
    echo "upstream_requests=$STATE_DIR/logs/validation/upstream-requests.jsonl"
    echo "artifacts=$STATE_DIR/data/artifacts"
  } | tee "$log"
  trap - EXIT
  smoke_cleanup_all
  docker network rm "$network" >/dev/null 2>&1 || true
  local residue
  for residue in ${SMOKE_WORKSPACES[@]+"${SMOKE_WORKSPACES[@]}"}; do
    [[ ! -e "$residue" ]] || fail "smoke workspace cleanup failed: $residue remains"
  done
  echo "Pi scripted smoke recorded: log=$log (workspace_cleanup=PASS network_cleanup=PASS workspaces_removed=${#SMOKE_WORKSPACES[@]})"
}

evidence_verify() {
  [[ $# == 0 ]] || fail "evidence-verify takes no arguments"
  local evidence_dir="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/evidence/M2"
  local evidence_root="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff"
  local report="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/reports/M2.md"
  local status="$ROOT_DIR/docs/exec-plans/dev-factory-v1-replanned-handoff/STATUS.yaml"
  [[ -f "$report" && -f "$status" ]] || fail "M2 report/status missing"
  local head
  head=$(git -C "$ROOT_DIR" rev-parse HEAD)
  local candidate_head
  candidate_head=$(sed -n 's/^Code candidate HEAD: `\([^`]*\)`.*/\1/p' "$report")
  [[ -n "$candidate_head" ]] || fail "report code candidate HEAD is missing"
  git -C "$ROOT_DIR" merge-base --is-ancestor "$candidate_head" HEAD ||
    fail "report code candidate is not an ancestor of current tree"
  grep -q '^state: COMPLETE$' "$status" || fail "STATUS.yaml is not COMPLETE"
  grep -q '^State: COMPLETE\.' "$report" || fail "report state disagrees with STATUS.yaml"
  local path
  while IFS= read -r path; do
    [[ -f "$evidence_root/$path" ]] || fail "cited evidence missing: $path"
    git -C "$ROOT_DIR" ls-files --error-unmatch "$evidence_root/$path" >/dev/null 2>&1 ||
      fail "cited evidence is untracked: $path"
  done < <(sed -n 's/.*`\(evidence\/M2\/[^`]*\)`.*/\1/p' "$report" "$status" | sort -u)
  while IFS= read -r path; do
    [[ -f "$evidence_root/$path" ]] || fail "STATUS evidence missing: $path"
    git -C "$ROOT_DIR" ls-files --error-unmatch "$evidence_root/$path" >/dev/null 2>&1 ||
      fail "STATUS evidence is untracked: $path"
  done < <(sed -n 's/^[[:space:]]*M2-C[1-7]:[[:space:]]*\(evidence\/M2\/[^[:space:]]*\).*$/\1/p' "$status" | sort -u)
  "$ROOT_DIR/scripts/factory" smoke --pi --scripted >/tmp/factory-evidence-smoke.log
  local fresh="$ROOT_DIR/.factory/data/artifacts/pi-smoke-candidate.json"
  cmp -s "$evidence_dir/candidate.json" "$fresh" || fail "candidate evidence does not match fresh smoke"
  local validation="$ROOT_DIR/.factory/logs/validation/unit-tests.txt"
  "$ROOT_DIR/scripts/factory" validate --unit >/tmp/factory-evidence-unit.log
  local fresh_count recorded_count
  fresh_count=$(sed -n 's/^TOTAL_TESTS=//p' "$validation" | tail -1)
  recorded_count=$(sed -n 's/^- `\.\/scripts\/factory validate --unit`: exit 0, \([0-9][0-9]*\) tests.*/\1/p' "$report" | head -1)
  [[ -n "$recorded_count" && "$fresh_count" == "$recorded_count" ]] ||
    fail "recorded test count $recorded_count disagrees with fresh count $fresh_count"
  echo "evidence-verify: PASS head=$head candidate=$fresh_count tests direct-egress=DENIED"
}

stop_factory() {
  if ! running_pid; then
    rm -f "$PID_FILE"
    revoke_pi_gateways
    echo "Factory is not running"
    return 0
  fi
  local pid
  pid=$(<"$PID_FILE")
  kill -TERM "$pid"
  local attempt
  for attempt in $(seq 1 30); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      revoke_pi_gateways
      echo "Factory stopped; persistent data was preserved"
      return 0
    fi
    sleep 1
  done
  revoke_pi_gateways
  fail "Factory PID $pid did not stop after SIGTERM; inspect $APP_LOG"
}

revoke_pi_gateways() {
  [[ -f "$CONFIG_FILE" && -f "$PASSWORD_FILE" && -f "$MODEL_TOKEN_FILE" ]] || return 0
  compose rm -sf factory-gateway factory-dependency-gateway >/dev/null 2>&1 || true
}

guard_legacy_pgdata() {
  # Pre-M3 compose stored PostgreSQL in the named volume factory_factory-pgdata;
  # the current bind-mounted data directory starts empty, so recreating the
  # container on the new storage silently hides that execution history
  # (observed and imported during M4).  Refuse to proceed until the legacy
  # data is imported and the marker file exists.
  if command -v docker >/dev/null 2>&1 && \
     docker volume inspect factory_factory-pgdata >/dev/null 2>&1 && \
     [[ ! -f "$STATE_DIR/data/postgres.legacy-imported" ]]; then
    fail "legacy PostgreSQL volume factory_factory-pgdata exists but was not imported into .factory/data/postgres; refusing to reset execution history (see docs/exec-plans/dev-factory-v1-replanned-handoff/reports/M4.md)"
  fi
}

count_reports() {
  local marker="$1"
  local total=0
  local file tests failures errors skipped
  while IFS= read -r file; do
    tests=$(sed -n 's/.*<testsuite[^>]* tests="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    failures=$(sed -n 's/.*<testsuite[^>]* failures="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    errors=$(sed -n 's/.*<testsuite[^>]* errors="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    skipped=$(sed -n 's/.*<testsuite[^>]* skipped="\([0-9][0-9]*\)".*/\1/p' "$file" | head -1)
    total=$((total + ${tests:-0}))
    printf '%s tests=%s failures=%s errors=%s skipped=%s\n' \
      "${file#"$ROOT_DIR/"}" "${tests:-0}" "${failures:-0}" "${errors:-0}" "${skipped:-0}"
  done < <(find "$ROOT_DIR" -path '*/target/surefire-reports/TEST-*.xml' -newer "$marker" -type f | sort)
  echo "TOTAL_TESTS=$total"
}

validate_suite() {
  local option="${1:-}"
  local suite
  case "$option" in
    --unit) suite=unit ;;
    --integration) suite=integration ;;
    --eval-pack) suite=eval-pack ;;
    --gateway) suite=gateway ;;
    *) fail "validate requires --unit, --integration, --eval-pack, or --gateway" ;;
  esac
  init_factory >/dev/null
  load_config
  local marker="$STATE_DIR/run/validate-${suite}.marker"
  local log="$STATE_DIR/logs/validation/${suite}.log"
  local summary="$STATE_DIR/logs/validation/${suite}-tests.txt"
  if [[ "$suite" == gateway ]]; then
    python3 -m unittest discover -s "$ROOT_DIR/factory-gateway" -p 'test_*.py' > "$log" 2>&1 ||
      fail "gateway validation failed; see $log"
    local count
    count=$(sed -n 's/^Ran \([0-9][0-9]*\) tests.*/\1/p' "$log" | tail -1)
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || fail "gateway validation selected zero tests; see $log"
    grep -q '^OK' "$log" || fail "gateway validation was not OK; see $log"
    echo "gateway validation passed: $count tests; log=$log"
    return 0
  fi
  touch "$marker"
  if [[ "$suite" == integration ]]; then
    docker info >/dev/null 2>&1 || fail "integration suite requires Docker (BLOCKED_REQUIRES_DOCKER)"
    docker image inspect factory-pi:jdk21 >/dev/null 2>&1 ||
      docker build -q -t factory-pi:jdk21 "$ROOT_DIR/factory-sandbox"
  fi
  local rc=0
  (
    cd "$ROOT_DIR"
    export MAVEN_USER_HOME="$STATE_DIR/cache/maven-home"
    case "$suite" in
      unit) ./mvnw test -B '-Dgroups=!integration & !eval-pack & !live' ;;
      integration) ./mvnw test -B -Dgroups=integration -Dsurefire.failIfNoSpecifiedTests=false ;;
      eval-pack) ./mvnw test -B -Dgroups=eval-pack -Dsurefire.failIfNoSpecifiedTests=false ;;
    esac
  ) > "$log" 2>&1 || rc=$?
  count_reports "$marker" | tee "$summary"
  local total
  total=$(sed -n 's/^TOTAL_TESTS=//p' "$summary")
  [[ "$total" =~ ^[1-9][0-9]*$ ]] || fail "$suite selected zero tests; see $log"
  [[ "$rc" == 0 ]] || fail "$suite validation failed with exit $rc; see $log"
  if [[ "$suite" == integration ]]; then
    grep -q 'SandboxServiceIntegrationTest' "$summary" || fail "real Docker integration test was not selected"
  elif [[ "$suite" == eval-pack ]]; then
    grep -q 'EvalPackHermeticRegressionFixTest' "$summary" || fail "eval regression scenario missing"
    grep -q 'EvalPackHermeticCounterexampleTest' "$summary" || fail "eval counterexample scenario missing"
    grep -q 'EvalPackHermeticSummaryTest' "$summary" || fail "eval summary scenario missing"
  else
    grep -q 'CodingHarnessTest' "$summary" || fail "harness unit tests were not selected"
    grep -q 'AnthropicApiKeyGuardTest' "$summary" || fail "startup guard unit tests were not selected"
  fi
  echo "$suite validation passed: $total tests; log=$log; selection=$summary"
}

require_task_file() {
  local task_file="$1"
  [[ -f "$task_file" && ! -L "$task_file" ]] || fail "task input must be a regular non-symlink file"
  local size
  size=$(wc -c < "$task_file" | tr -d ' ')
  [[ "$size" -le 262144 ]] || fail "task input exceeds the 256 KiB limit"
}

resolve_task() {
  [[ $# == 1 ]] || fail "resolve-task requires one YAML or JSON task file"
  require_task_file "$1"
  load_config
  curl --fail-with-body -sS -H 'Content-Type: application/yaml' \
    -H "X-Task-Name: $(basename "$1")" --data-binary "@$1" \
    "http://127.0.0.1:${FACTORY_APP_PORT}/api/dev/tasks/resolve"
  printf '\n'
}

submit_task() {
  [[ $# == 1 ]] || fail "submit requires one YAML or JSON task file"
  require_task_file "$1"
  local inbox="$STATE_DIR/data/inbox"
  mkdir -p "$inbox"
  chmod 700 "$inbox"
  local name
  name=$(basename "$1")
  case "$name" in
    *.yaml|*.yml|*.json|*.YAML|*.YML|*.JSON) ;;
    *) fail "task filename must end in .yaml, .yml, or .json" ;;
  esac
  local final="$inbox/$name"
  [[ ! -e "$final" && ! -e "$final.partial" ]] || fail "inbox already contains $name"
  cp -- "$1" "$final.partial"
  chmod 600 "$final.partial"
  mv -- "$final.partial" "$final"
  echo "Task submitted atomically to $final"
}

run_eval() {
  [[ ( $# == 3 || ( $# == 5 && "$4" == --delivery-mode ) ) && "$2" == --run-key ]] ||
    fail "run-eval requires TASK_ID --run-key RUN_KEY [--delivery-mode LOCAL_ONLY|DELIVER_PR]"
  local task_id="$1" run_key="$3" delivery_mode="${5:-LOCAL_ONLY}"
  [[ "$delivery_mode" == LOCAL_ONLY || "$delivery_mode" == DELIVER_PR ]] ||
    fail "delivery mode must be LOCAL_ONLY or DELIVER_PR"
  [[ "$run_key" =~ ^[A-Za-z0-9._-]+$ && "$run_key" != default && ${#run_key} -le 128 ]] ||
    fail "runKey must be a fresh non-default value matching [A-Za-z0-9._-] and at most 128 characters"
  load_config
  local task_file="$ROOT_DIR/evals/tasks/${task_id}.md"
  [[ -f "$task_file" ]] || task_file="$ROOT_DIR/evals/derived/${task_id}.md"
  require_task_file "$task_file"
  # Task-declared open decisions are curated data (evals/decisions/<TASK>.json),
  # never code branches: a task with one is admitted into the decision flow and
  # pauses for a human answer before any coding budget is spent.
  local decision_file="$ROOT_DIR/evals/decisions/${task_id}.json"
  [[ -f "$decision_file" ]] || decision_file=""
  # Trusted curated mapping per task: repository + pinned base revision.
  # The MODSIDECAR-208 mapping is the frozen accepted benchmark (unchanged);
  # the seven dataset tasks use pinned origin/main SHAs captured 2026-09-11.
  # Plan selection mirrors each task's own acceptance criteria: tasks whose ACs
  # demand the full build incl. integration tests (mvn clean verify / "all
  # unit/integration tests pass") use java-maven-verify-it, whose check
  # requires the Docker capability; unit-gated tasks use java-maven-verify
  # (mvn test). In a sandbox without Docker the IT tasks are honestly
  # BLOCKED_ENVIRONMENT at preparation instead of burning coding budget.
  local repo base plan
  case "$task_id" in
    MODSIDECAR-208)
      repo="folio-org/folio-module-sidecar"
      base="c13e0383d9283ef554c195cf5357bb3c6eeb4e65"
      plan="modsidecar-208-v1" ;;
    # Dataset bases repaired 2026-09-12: each base is the parent of the
    # task's fix commit (repo state exactly BEFORE the fix). The original
    # shared per-repo bases (origin/main heads of 2026-09-08..10) already
    # contained every task's fix, which made positive solves impossible
    # ("already implemented" empties and patches failing over existing code).
    MGRENTITLE-161)
      repo="folio-org/mgr-tenant-entitlements"
      base="bebe335b1f86753a03ecbcbc14d3cd7811c22d42"
      plan="java-maven-verify-it" ;;
    MGRENTITLE-172)
      repo="folio-org/mgr-tenant-entitlements"
      base="dad5c4146bfb1761bb64f3df1054548dac9e6009"
      plan="java-maven-verify-it" ;;
    MGRENTITLE-192)
      repo="folio-org/mgr-tenant-entitlements"
      base="8c5a9a2b01cdc804bafe7176669e7ca64efc1270"
      plan="java-maven-verify" ;;
    MODROLESKC-424)
      repo="folio-org/mod-roles-keycloak"
      base="d80e83f6281736e53b17064a79615609f7c21126"
      plan="java-maven-verify-it" ;;
    MODROLESKC-427)
      repo="folio-org/mod-roles-keycloak"
      base="cb76d7166affaae024bfbbeba98f1aad64496a62"
      plan="java-maven-verify-it" ;;
    MODSCHED-70)
      repo="folio-org/mod-scheduler"
      base="409150b6787c884b94f0f2de1115e67634d6abef"
      plan="java-maven-verify-it" ;;
    MODSCHED-76)
      repo="folio-org/mod-scheduler"
      base="a8ac6c8862e3692adfd0c03936df6c46fd5ecd3d"
      plan="java-maven-verify" ;;
    # Derived (not benchmark): open issue MODSIDECAR-207 at origin/master of
    # 2026-09-15; its derived ACs are unit-gated, so the unit plan applies.
    MODSIDECAR-207)
      repo="folio-org/folio-module-sidecar"
      base="4e7947e48f029977c9c42ffed4230f9e0f177f73"
      plan="java-maven-verify" ;;
    *) fail "no trusted curated mapping for task: $task_id" ;;
  esac
  local generated="$STATE_DIR/run/${task_id}-${run_key}.json"
  [[ ! -e "$generated" && ! -L "$generated" ]] || fail "run-eval mapping already exists: $generated"
  python3 - "$task_file" "$run_key" "$generated" "$task_id" "$repo" "$base" "$plan" "$decision_file" "$delivery_mode" <<'PY'
import json
import pathlib
import re
import sys

task_file, run_key, output, task_id, repo, base, plan, decision_file, delivery_mode = sys.argv[1:10]
raw = pathlib.Path(task_file).read_text(encoding="utf-8")
if task_id == "MODSIDECAR-208":
    payload = {
        "schemaVersion": 1,
        "source": {"type": "JIRA", "id": "MODSIDECAR-208", "project": "MODSIDECAR"},
        "repository": "folio-org/folio-module-sidecar",
        "baseRevision": "c13e0383d9283ef554c195cf5357bb3c6eeb4e65",
        "profileId": "java21-pi-unit",
        "verificationPlanId": "modsidecar-208-v1",
        "runKey": run_key,
        "deliveryMode": delivery_mode,
        "metadata": {"evalId": "MODSIDECAR-208", "mappingVersion": "modsidecar-208-v1",
                  "sourceTaskText": raw},
        "goal": "Implement the complete MODSIDECAR-208 task and satisfy its acceptance criteria.",
        "acceptanceCriteria": [
            {"id": "AC1", "text": "quarkus.thread-pool.max-threads is configured and defaults to 8.", "source": "TASK"},
            {"id": "AC2", "text": "QUARKUS_THREAD_POOL_MAX_THREADS overrides the configured value and defaults to 8 when unset.", "source": "TASK"},
            {"id": "AC3", "text": "README.md documents the variable, default value, description, and required flag.", "source": "TASK"},
            {"id": "AC4", "text": "The project compiles and passes the Maven test checks.", "source": "TASK"},
        ],
        "constraints": {"allow_paths": ["src/main/resources/application.properties", "README.md", "src/test/**", "NEWS.md"]},
        "notes": "Use only the prepared repository. Factory performs independent verification after coding.",
    }
else:
    goal_match = re.search(r"^# (.+)$", raw, re.M)
    goal = goal_match.group(1).strip() if goal_match else None
    if not goal:
        raise SystemExit(f"no goal heading found in {task_file}")
    acs = []
    for match in re.finditer(r"^-\s+\*\*(AC\d+):\*\*\s+(.+)$", raw, re.M):
        acs.append({"id": match.group(1), "text": match.group(2).strip(), "source": "TASK"})
    if not acs:
        # Gherkin-style criteria ("- **ACn: Title**" plus indented Given/When/Then
        # sub-bullets, observed in MGRENTITLE-192 during the 2026-09-12 batch) are
        # normalized into the canonical single-line form before failing over.
        def _gherkin_to_canonical(m):
            title = " ".join(m.group(2).split())
            bullets = re.findall(r"^[ \t]+-[ \t]+(.+)$", m.group(3), re.M)
            text = title + (": " + "; ".join(" ".join(b.split()) for b in bullets) if bullets else "")
            return "- **%s:** %s" % (m.group(1), text)
        normalized = re.sub(
            r"^-\s+\*\*(AC\d+):\s*([^*\n]+)\*\*\s*\n((?:[ \t]+-[ \t]+.*\n?)+)",
            _gherkin_to_canonical, raw, flags=re.M)
        for match in re.finditer(r"^-\s+\*\*(AC\d+):\*\*\s+(.+)$", normalized, re.M):
            acs.append({"id": match.group(1), "text": match.group(2).strip(), "source": "TASK"})
    if not acs:
        raise SystemExit(f"no structured acceptance criteria found in {task_file}")
    payload = {
        "schemaVersion": 1,
        "source": {"type": "JIRA", "id": task_id, "project": task_id.split("-", 1)[0]},
        "repository": repo,
        "baseRevision": base,
        "profileId": "java21-pi-unit",
        "verificationPlanId": plan,
        "runKey": run_key,
        "deliveryMode": delivery_mode,
        "metadata": {"evalId": task_id, "mappingVersion": "dataset-2026-09-11-v1",
                  "sourceTaskText": raw},
        "goal": goal + " Implement the complete task and satisfy its acceptance criteria.",
        "acceptanceCriteria": acs,
        "constraints": {"allow_paths": ["src/**", "README.md", "NEWS.md"]},
        "notes": "Use only the prepared repository. Factory performs independent verification after coding.",
    }
if decision_file:
    payload["decisions"] = [json.loads(pathlib.Path(decision_file).read_text(encoding="utf-8"))]
pathlib.Path(output).write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
  chmod 600 "$generated"
  local source_name execution_id receipt_state
  source_name=$(basename "$generated")
  submit_task "$generated" >/dev/null
  for _ in $(seq 1 30); do
    receipt_state=$(python3 - "$STATE_DIR/data/inbox" "$source_name" <<'PY'
import json
import pathlib
import sys

inbox, source_name = sys.argv[1:]
matches = []
for directory in ("processed", "blocked", "failed"):
    root = pathlib.Path(inbox) / directory
    if not root.is_dir():
        continue
    for path in root.glob("*.receipt.json"):
        try:
            receipt = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if receipt.get("sourceFile") == source_name:
            matches.append((path, receipt))
if len(matches) > 1:
    raise SystemExit(f"multiple admission receipts found for {source_name}")
if not matches:
    raise SystemExit(0)
path, receipt = matches[0]
if receipt.get("status") == "ADMITTED" and receipt.get("executionId"):
    print("ADMITTED:" + receipt["executionId"])
else:
    print("REJECTED:" + str(receipt.get("code", "UNKNOWN")) + ":" + str(receipt.get("message", "")))
PY
    )
    case "$receipt_state" in
      ADMITTED:*)
        execution_id="${receipt_state#ADMITTED:}"
        [[ "$execution_id" =~ ^[0-9a-fA-F-]{36}$ ]] ||
          fail "admission receipt contains an invalid execution id; mapping retained at $generated"
      echo "Run admitted: task=$task_id runKey=$run_key execution-id=$execution_id"
      echo "Mapping retained at $generated"
      return 0
        ;;
      REJECTED:*)
        fail "task admission rejected: ${receipt_state#REJECTED:}; mapping retained at $generated"
        ;;
    esac
    sleep 2
  done
  fail "run was submitted but admission was not visible within 60 seconds; mapping retained at $generated"
}

show_execution() {
  [[ $# == 1 || $# == 2 ]] || fail "show requires EXECUTION_ID [--watch]"
  local execution_id="$1" watch=false
  [[ "$execution_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "execution id must be a UUID"
  if [[ $# == 2 ]]; then
    [[ "$2" == --watch ]] || fail "show accepts only --watch as its second argument"
    watch=true
  fi
  load_config
  local response status
  while true; do
    response=$(curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/api/executions/${execution_id}") ||
      fail "execution $execution_id is not available"
    printf '%s' "$response" > "$STATE_DIR/run/show-payload.json"
    status=$(python3 - "$STATE_DIR/run/show-payload.json" <<'PY'
import hashlib
import json
import sys

detail = json.load(open(sys.argv[1], encoding="utf-8"))
execution = detail.get("execution", {})
interesting = {"baseline.json", "candidate.json", "candidate.patch", "verification.json", "repair.json", "usage.json", "result.json", "manifest.json", "decision-request.json", "decision-answer.json", "decision-resolution.json"}
artifacts = []
for item in detail.get("artifacts", []):
    content = item.get("content") or ""
    entry = {"name": item.get("name"), "version": item.get("version"),
             "bytes": len(content.encode()), "sha256": hashlib.sha256(content.encode()).hexdigest()}
    if item.get("name") in interesting:
        try:
            parsed = json.loads(content)
            entry["summary"] = {k: parsed[k] for k in parsed if k in {"status", "outcome", "benchmarkOutcome", "stage", "reason", "provider_calls", "settled", "cost_status", "candidateTree", "patchSha256", "decisionId", "question", "resolutionMode", "selectedOptionId", "answeredBy"}}
        except json.JSONDecodeError:
            pass
    artifacts.append(entry)
print(json.dumps({"execution": execution, "error": detail.get("errorMessage"), "artifacts": artifacts}, separators=(",", ":")))
print(execution.get("status", ""), file=sys.stderr)
PY
)
    printf '%s\n' "${status%%$'\n'*}"
    if [[ "$watch" != true || "$status" == *COMPLETED* || "$status" == *FAILED_ESCALATED* || "$status" == *REJECTED* || "$status" == *CANCELLED* || "$status" == *AWAITING_HITL* ]]; then
      return 0
    fi
    sleep 2
  done
}

export_execution() {
  [[ $# == 3 && "$2" == --out ]] || fail "export requires EXECUTION_ID --out DIRECTORY"
  local execution_id="$1" output_dir="$3"
  [[ "$execution_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "execution id must be a UUID"
  [[ -n "$output_dir" && "$output_dir" != "/" && "$output_dir" != "$ROOT_DIR" ]] ||
    fail "export directory is too broad"
  load_config
  mkdir -p "$output_dir"
  [[ ! -L "$output_dir" ]] || fail "export directory must not be a symbolic link"
  local response
  response=$(curl -fsS "http://127.0.0.1:${FACTORY_APP_PORT}/api/executions/${execution_id}") ||
    fail "execution $execution_id is not available"
  printf '%s' "$response" > "$STATE_DIR/run/export-payload.json"
  python3 - "$STATE_DIR/run/export-payload.json" "$output_dir" <<'PY'
import hashlib
import json
import os
import pathlib
import re
import sys

detail = json.load(open(sys.argv[1], encoding="utf-8"))
out = pathlib.Path(sys.argv[2]).resolve()
out.mkdir(parents=True, exist_ok=True)
if out == pathlib.Path("/"):
    raise SystemExit("refusing to export to filesystem root")
manifest = {"execution": detail.get("execution"), "artifacts": []}
artifacts = detail.get("artifacts", [])
versions_by_name = {}
for item in artifacts:
    versions_by_name.setdefault(item.get("name", ""), []).append(item)

def write_new(path, content):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(str(path), flags, 0o600)
    except FileExistsError:
        raise SystemExit(f"refusing to overwrite existing export file: {path}")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
    except Exception:
        try:
            os.unlink(path)
        except OSError:
            pass
        raise

for item in artifacts:
    name = item.get("name", "")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        raise SystemExit(f"unsafe artifact name: {name!r}")
    if name == "execution.json":
        raise SystemExit("artifact name is reserved: execution.json")
    content = item.get("content") or ""
    version = item.get("version")
    if len(versions_by_name[name]) > 1:
        artifact_path = pathlib.Path(name)
        filename = f"{artifact_path.stem}.v{version}{artifact_path.suffix}"
    else:
        filename = name
    path = out / filename
    write_new(path, content)
    manifest["artifacts"].append({"name": name, "file": filename, "version": version,
        "sha256": hashlib.sha256(content.encode()).hexdigest(), "bytes": len(content.encode())})
for name, versions in versions_by_name.items():
    if len(versions) <= 1:
        continue
    latest = max(versions, key=lambda item: item.get("version", 0))
    write_new(out / name, latest.get("content") or "")
write_new(out / "execution.json", json.dumps(manifest, indent=2) + "\n")
print(json.dumps({"execution": detail.get("execution", {}).get("id"), "out": str(out),
                  "artifacts": [a["name"] for a in manifest["artifacts"]]}))
PY
}

deliver_execution() {
  [[ $# == 1 ]] || fail "deliver requires EXECUTION_ID"
  local execution_id="$1"
  [[ "$execution_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "execution id must be a UUID"
  load_config
  # Trusted delivery of a completed SUCCESS execution: Factory reproduces the
  # verified candidate and pushes/opens the PR with its own delivery credential
  # (FACTORY_DELIVERY_GITHUB_TOKEN of the running Factory process).
  curl --fail-with-body -sS -X POST \
    "http://127.0.0.1:${FACTORY_APP_PORT}/api/dev/executions/${execution_id}/delivery"
  printf '\n'
}

decide_execution() {
  [[ $# -ge 1 ]] || fail "decide requires EXECUTION_ID --decision-id ID (--option OPTION_ID | --free-text TEXT) --reviewer NAME [--comment TEXT]"
  local execution_id="$1" decision_id="" option="" free_text="" reviewer="" comment=""
  shift
  [[ "$execution_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "execution id must be a UUID"
  while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || fail "decide option $1 requires a value"
    case "$1" in
      --decision-id) decision_id="$2" ;;
      --option) option="$2" ;;
      --free-text) free_text="$2" ;;
      --reviewer) reviewer="$2" ;;
      --comment) comment="$2" ;;
      *) fail "unknown decide option: $1" ;;
    esac
    shift 2
  done
  [[ -n "$decision_id" && -n "$reviewer" ]] || fail "decide requires --decision-id and --reviewer"
  if [[ ( -n "$option" && -n "$free_text" ) || ( -z "$option" && -z "$free_text" ) ]]; then
    fail "decide requires exactly one of --option or --free-text"
  fi
  load_config
  local body="$STATE_DIR/run/decide-${execution_id}.json"
  python3 - "$body" "$decision_id" "$option" "$free_text" "$reviewer" "$comment" <<'PY'
import json
import sys

path, decision_id, option, free_text, reviewer, comment = sys.argv[1:7]
json.dump({"decisionId": decision_id, "selectedOptionId": option or None, "freeText": free_text or None,
           "reviewer": reviewer, "comment": comment or None}, open(path, "w", encoding="utf-8"))
PY
  chmod 600 "$body"
  curl --fail-with-body -sS -H 'Content-Type: application/json' --data-binary "@$body" \
    "http://127.0.0.1:${FACTORY_APP_PORT}/api/dev/executions/${execution_id}/decision"
  printf '\n'
}

command="${1:-}"
shift || true
case "$command" in
  init) [[ $# == 0 ]] || fail "init takes no arguments"; init_factory ;;
  infra) infra "$@" ;;
  doctor)
    case "${1:-}" in
      --offline) [[ $# == 1 ]] || fail "doctor --offline takes no extra arguments"; doctor_offline ;;
      --live) [[ $# == 1 ]] || fail "doctor --live takes no extra arguments"; doctor_live ;;
      *) fail "doctor requires --offline or --live" ;;
    esac
    ;;
  start) start_factory "$@" ;;
  stop) [[ $# == 0 ]] || fail "stop takes no arguments"; stop_factory ;;
  validate) validate_suite "$@" ;;
  smoke) smoke_pi_scripted "$@" ;;
  evidence-verify) evidence_verify "$@" ;;
  resolve-task) resolve_task "$@" ;;
  submit) submit_task "$@" ;;
  run-eval) run_eval "$@" ;;
  show) show_execution "$@" ;;
  export) export_execution "$@" ;;
  decide) decide_execution "$@" ;;
  deliver) deliver_execution "$@" ;;
  *) usage; exit 1 ;;
esac
